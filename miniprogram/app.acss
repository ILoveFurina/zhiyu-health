page {
  min-height: 100%;
  background: linear-gradient(180deg, #e9f6f2 0%, #f4faf8 45%, #f8faf9 100%);
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;

  /* 设计 token（票 42）：新页面排版统一消费此处变量；旧页（chat/挂号/档案/处方/消息/药品订单）已完成机械替换 */
  --zy-color-primary: #00a870; /* 主行动色（医疗绿），tabBar selectedColor 与此同值 */
  --zy-color-primary-soft: #e3f5ee; /* 主色浅底，chip/徽标背景 */
  --zy-text-title: #173f3a;
  --zy-text-secondary: #6f8581;
  --zy-text-weak: #9db3af;
  --zy-radius-card: 24rpx;
  --zy-space-xs: 8rpx;
  --zy-space-sm: 16rpx;
  --zy-space-md: 24rpx;
  --zy-space-lg: 32rpx;
  --zy-space-xl: 48rpx;

  /* ===== 票 66 视觉基线 token 补全 ===== */
  /* 语义色：danger/warning 及其浅底（badge/警示条背景） */
  --zy-color-danger: #e64545;
  --zy-color-danger-soft: #fdeceb;
  --zy-color-warning: #b26a00;
  --zy-color-warning-soft: #fdf3e3;
  /* 描边/分隔线与浅填充（输入框、灰底 chip） */
  --zy-color-border: #eef3f1;
  --zy-color-fill: #f2f5f4;
  /* 阴影三级：卡片 / 悬浮卡（取自 health）/ 弹层 */
  --zy-shadow-card: 0 2rpx 10rpx rgba(0, 0, 0, 0.06);
  --zy-shadow-raised: 0 8rpx 30rpx rgba(28, 91, 80, 0.07);
  --zy-shadow-pop: 0 12rpx 40rpx rgba(0, 0, 0, 0.12);
  /* 圆角分级（999rpx 胶囊与 50% 正圆保持字面量） */
  --zy-radius-sm: 16rpx;
  --zy-radius-lg: 32rpx;
  /* 动效：克制 ≤400ms，动画只用 transform/opacity */
  --zy-motion-fast: 150ms;
  --zy-motion-base: 250ms;
  --zy-motion-slow: 400ms;
  --zy-ease-out: cubic-bezier(0.22, 0.61, 0.36, 1);
  /* 字阶四档：标题/正文/辅助/弱 */
  --zy-font-title: 32rpx;
  --zy-font-body: 28rpx;
  --zy-font-aux: 24rpx;
  --zy-font-weak: 20rpx;
}

/* ===== 票 66：图标字体（Remix Icon v4.6.0，Apache-2.0；pyftsubset 裁出 15 枚线性图标 base64 内嵌，零图片资产） ===== */
@font-face {
  font-family: 'zyicon';
  src: url('data:font/truetype;charset=utf-8;base64,') format('truetype');
}
/* 用法：<view class="zy-ico zy-ico-plus"></view>，尺寸/颜色由所在容器 font-size/color 控制 */
.zy-ico::before {
  font-family: 'zyicon';
  font-style: normal;
  font-weight: normal;
  display: inline-block;
  line-height: 1;
}
.zy-ico-plus::before { content: '\ea13'; }      /* add-line：智能导诊/新建 */
.zy-ico-scan::before { content: '\ead0'; }      /* body-scan-line：拍皮肤 */
.zy-ico-calendar::before { content: '\eb23'; }  /* calendar-check-line：预约挂号/排班 */
.zy-ico-camera::before { content: '\eb31'; }    /* camera-line：拍照 */
.zy-ico-capsule::before { content: '\eb37'; }   /* capsule-line：药品订单/拍药盒 */
.zy-ico-tongue::before { content: '\ebd4'; }    /* contrast-2-line：拍舌苔 */
.zy-ico-report::before { content: '\ecef'; }    /* file-list-3-line：报告解读 */
.zy-ico-file::before { content: '\ed0f'; }      /* file-text-line：PDF/处方 */
.zy-ico-heart::before { content: '\ee11'; }     /* heart-pulse-line：健康档案 */
.zy-ico-image::before { content: '\ee4b'; }     /* image-line：相册 */
.zy-ico-mail::before { content: '\eef6'; }      /* mail-line：消息中心 */
.zy-ico-mic::before { content: '\ef50'; }       /* mic-line：语音输入 */
.zy-ico-diet::before { content: '\f084'; }      /* restaurant-line：拍饮食 */
.zy-ico-consult::before { content: '\f197'; }   /* stethoscope-line：在线问诊 */
.zy-ico-ticket::before { content: '\f20b'; }    /* ticket-2-line：我的挂号 */

/* ===== 票 66：骨架屏 shimmer（数据到达前灰色轮廓，替代纯文字加载） ===== */
@keyframes zy-shimmer {
  0% { background-position: 100% 0; }
  100% { background-position: -100% 0; }
}
.zy-skel {
  background: linear-gradient(90deg, var(--zy-color-fill) 25%, #fafcfb 50%, var(--zy-color-fill) 75%);
  background-size: 200% 100%;
  animation: zy-shimmer 1.2s linear infinite;
}
.zy-skel-card {
  margin-bottom: 20rpx;
  padding: var(--zy-space-md);
  border-radius: var(--zy-radius-card);
  background: #fff;
  box-shadow: var(--zy-shadow-card);
}
.zy-skel-line { height: 28rpx; border-radius: var(--zy-radius-sm); }
.zy-skel-circle { border-radius: 50%; }

/* ===== 票 66：微交互（列表浮入 / 按压反馈） ===== */
@keyframes zy-fade-up {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}
/* 列表卡片逐条浮入：axml 循环里配 style="animation-delay: {{index * 40}}ms" 做 stagger */
.zy-fade-in { animation: zy-fade-up var(--zy-motion-base) var(--zy-ease-out) both; }
/* 可点卡片/按钮按压态；元素已有 transform/动画时在页面 acss 内联同规则而非加此类 */
.zy-press { transition: transform var(--zy-motion-fast) var(--zy-ease-out); }
.zy-press:active { transform: scale(0.98); }
