/* AI挂号助手主卡（票 49）：首页与对话空态共用，消费 app.acss 设计 token */
.reg-card {
  padding: var(--zy-space-md);
  border-radius: var(--zy-radius-card);
  background: #fff;
  box-shadow: var(--zy-shadow-card);
}

.reg-title { color: var(--zy-text-title); font-size: 34rpx; font-weight: 700; }

.reg-entries { margin-top: var(--zy-space-md); display: flex; gap: var(--zy-space-sm); }
.reg-entry {
  flex: 1;
  padding: var(--zy-space-sm);
  border-radius: var(--zy-radius-sm);
  background: var(--zy-color-primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--zy-space-xs);
  transition: transform var(--zy-motion-fast) var(--zy-ease-out);
}
.reg-entry:active { transform: scale(0.98); }
.reg-entry-icon { color: var(--zy-color-primary); font-size: 32rpx; }
.reg-entry-label { color: var(--zy-color-primary); font-size: 28rpx; font-weight: 600; }

.reg-hospitals { margin-top: var(--zy-space-sm); }
.reg-hospital {
  padding: var(--zy-space-sm) 0;
  border-bottom: 1rpx solid var(--zy-color-border);
  display: flex;
  align-items: center;
  transition: transform var(--zy-motion-fast) var(--zy-ease-out);
}
.reg-hospital:active { transform: scale(0.98); }
.reg-hospital:last-child { border-bottom: none; }
.reg-hospital-main { flex: 1; }
.reg-name-row { display: flex; align-items: center; gap: var(--zy-space-sm); }
.reg-name { color: var(--zy-text-title); font-size: 28rpx; font-weight: 600; }
.reg-level {
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: var(--zy-color-primary-soft);
  color: var(--zy-color-primary);
  font-size: 20rpx;
}
.reg-meta { margin-top: 6rpx; color: var(--zy-text-secondary); font-size: 23rpx; }
.reg-arrow { margin-left: var(--zy-space-sm); color: var(--zy-text-weak); font-size: 36rpx; }
.reg-empty { padding: var(--zy-space-md) 0; color: var(--zy-text-weak); font-size: 24rpx; text-align: center; }

.reg-footer {
  margin-top: var(--zy-space-xs);
  padding-top: var(--zy-space-sm);
  border-top: 1rpx solid var(--zy-color-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.reg-total { color: var(--zy-text-secondary); font-size: 24rpx; }
.reg-relocate { color: var(--zy-color-primary); font-size: 24rpx; }
