<view class="reg-card">
  <view class="reg-title">AI挂号助手</view>

  <view class="reg-entries">
    <view class="reg-entry" onTap="tapDepartment">
      <view class="reg-entry-icon zy-ico zy-ico-calendar"></view>
      <view class="reg-entry-label">科室挂号</view>
    </view>
    <view class="reg-entry" onTap="tapGuide">
      <view class="reg-entry-icon zy-ico zy-ico-plus"></view>
      <view class="reg-entry-label">智能导诊</view>
    </view>
  </view>

  <view class="reg-directory" onTap="tapMore">
    <text>{{cityName || '当前城市'}} · 附近 {{total}} 家医院</text>
    <text class="reg-arrow">›</text>
  </view>
</view>
