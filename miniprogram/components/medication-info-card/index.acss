.med-info-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.med-info-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}

.med-item {
  border-bottom: 1rpx solid #f0f0f0;
  padding-bottom: 16rpx;
  margin-bottom: 16rpx;
}

.med-item:last-child {
  border-bottom: none;
  margin-bottom: 0;
}

.med-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.med-generic {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 4rpx;
}

.med-spec {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 8rpx;
}

.med-instructions {
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
}
