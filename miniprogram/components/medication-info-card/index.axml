<view class="med-info-card">
  <view class="med-info-title">药品说明书</view>
  <view a:for="{{card.medications}}" a:key="name" class="med-item">
    <view class="med-name">{{item.name}}</view>
    <view a:if="{{item.generic_name}}" class="med-generic">通用名：{{item.generic_name}}</view>
    <view a:if="{{item.specification}}" class="med-spec">规格：{{item.specification}}</view>
    <view class="med-instructions">{{item.instructions}}</view>
  </view>
  <ai-disclaimer text="{{disclaimer}}" />
</view>
