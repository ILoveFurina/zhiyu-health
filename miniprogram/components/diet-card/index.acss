.diet-card {
  background: #fff;
  border-radius: var(--zy-radius-sm);
  padding: 24rpx;
  box-shadow: var(--zy-shadow-card);
}

.diet-card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--zy-text-title);
  margin-bottom: 16rpx;
}

.meal-type {
  font-size: 28rpx;
  color: var(--zy-text-title);
  margin-bottom: 8rpx;
}

.calories {
  font-size: 28rpx;
  color: var(--zy-color-primary);
  margin-bottom: 16rpx;
}

.foods {
  margin-bottom: 16rpx;
}

.food {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--zy-color-border);
}

.food:last-child {
  border-bottom: none;
}

.food-head {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.risk-label {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--zy-radius-sm);
  margin-right: 16rpx;
  color: #fff;
}

.risk-green {
  background: var(--zy-color-primary);
}

.risk-yellow {
  background: var(--zy-color-warning);
}

.risk-red {
  background: var(--zy-color-danger);
}

.food-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--zy-text-title);
}

.food-amount {
  font-size: 24rpx;
  color: var(--zy-text-weak);
  margin-left: 12rpx;
}

.food-text {
  font-size: 26rpx;
  color: var(--zy-text-secondary);
  line-height: 1.5;
}

.nutrition-summary {
  font-size: 28rpx;
  color: var(--zy-text-title);
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.diet-advice {
  font-size: 26rpx;
  color: var(--zy-color-primary);
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.personal-tip {
  font-size: 26rpx;
  color: var(--zy-color-warning);
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.need-doctor {
  font-size: 26rpx;
  color: var(--zy-color-danger);
  margin-bottom: 16rpx;
}
