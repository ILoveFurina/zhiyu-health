/* 购药预览卡（票 88）：只展示非敏感稳定事实，点击跳统一购药确认页。
 * 类名带 doc- 前缀--支付宝组件样式不隔离，与 drug-orders 页/doctor-card 等裸类名会串扰。 */
.doc-card {
  padding: var(--zy-space-md);
  border-radius: var(--zy-radius-card);
  background: #fff;
  box-shadow: var(--zy-shadow-card);
}

.doc-head { display: flex; align-items: center; justify-content: space-between; }
.doc-title-row { display: flex; align-items: center; gap: var(--zy-space-sm); }
.doc-title { color: var(--zy-text-title); font-size: 32rpx; font-weight: 700; }
/* 字体图标：尺寸/颜色由容器 font-size/color 控制（见 app.acss .zy-ico 注释） */
.doc-title-icon { color: var(--zy-color-primary); font-size: 36rpx; }
.doc-source-tag {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
}
.doc-source-tag-OTC { background: var(--zy-color-primary-soft); color: var(--zy-color-primary); }
.doc-source-tag-PRESCRIPTION { background: var(--zy-color-warning-soft); color: var(--zy-color-warning); }

/* 处方来源：处方药路径才渲染，浅底区块强调出处 */
.doc-rx-source {
  margin-top: var(--zy-space-sm);
  padding: var(--zy-space-sm);
  border-radius: var(--zy-radius-sm);
  background: var(--zy-color-fill);
}
.doc-rx-label { color: var(--zy-text-weak); font-size: 22rpx; }
.doc-rx-text { margin-top: 4rpx; color: var(--zy-text-title); font-size: 26rpx; font-weight: 600; }
.doc-rx-line { margin-top: var(--zy-space-xs); color: var(--zy-text-secondary); font-size: 24rpx; }

.doc-items { margin-top: var(--zy-space-sm); }
.doc-item {
  margin-top: var(--zy-space-sm);
  padding: var(--zy-space-sm);
  border-radius: var(--zy-radius-sm);
  border: 1rpx solid var(--zy-color-border);
}
.doc-item:first-child { margin-top: 0; }
.doc-item-head { display: flex; align-items: center; justify-content: space-between; }
.doc-item-name { color: var(--zy-text-title); font-size: 28rpx; font-weight: 600; }
.doc-item-qty { flex-shrink: 0; color: var(--zy-text-secondary); font-size: 26rpx; }
.doc-item-spec { margin-top: 4rpx; color: var(--zy-text-weak); font-size: 22rpx; }

.doc-hint { margin-top: var(--zy-space-sm); color: var(--zy-text-weak); font-size: 22rpx; }
.doc-btn {
  margin-top: var(--zy-space-sm);
  padding: 18rpx 0;
  border-radius: var(--zy-radius-lg);
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  transition: transform var(--zy-motion-fast) var(--zy-ease-out);
}
.doc-btn:active { transform: scale(0.98); }
.doc-btn-open { background: var(--zy-color-primary); color: #fff; }
