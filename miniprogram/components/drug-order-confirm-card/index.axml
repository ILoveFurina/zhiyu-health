<view class="doc-card">
  <view class="doc-head">
    <view class="doc-title-row">
      <view class="doc-title-icon zy-ico zy-ico-capsule"></view>
      <view class="doc-title">购药预览</view>
    </view>
    <view class="doc-source-tag doc-source-tag-{{card.source}}">
      {{card.source === 'PRESCRIPTION' ? '处方药' : '非处方药'}}
    </view>
  </view>

  <!-- 处方药路径：处方来源（开方医生 + 日期）与来源医院/院区/锁定药房，OTC 路径不渲染 -->
  <block a:if="{{card.source === 'PRESCRIPTION'}}">
    <view a:if="{{prescriptionSourceText}}" class="doc-rx-source">
      <view class="doc-rx-label">处方来源</view>
      <view class="doc-rx-text">{{prescriptionSourceText}}</view>
    </view>
    <view a:if="{{card.hospital_name || card.campus_name}}" class="doc-rx-line">
      {{card.hospital_name}}{{card.campus_name ? ' · ' + card.campus_name : ''}}
    </view>
    <view a:if="{{card.pharmacy_name}}" class="doc-rx-line">履约药房：{{card.pharmacy_name}}（处方锁定）</view>
  </block>

  <!-- 药品明细：只展示名称/规格/数量，不展示价格库存（以确认页实时校验为准） -->
  <view class="doc-items">
    <view a:for="{{card.items}}" a:key="medication_id" class="doc-item">
      <view class="doc-item-head">
        <view class="doc-item-name">{{item.name}}</view>
        <view class="doc-item-qty">× {{item.quantity}}</view>
      </view>
      <view a:if="{{item.specification}}" class="doc-item-spec">{{item.specification}}</view>
    </view>
  </view>

  <view class="doc-hint">价格与库存以确认页实时校验为准</view>
  <view class="doc-btn doc-btn-open" onTap="open">去确认下单</view>
</view>
