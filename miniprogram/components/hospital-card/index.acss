.card {
  margin: 16rpx 0;
  padding: 24rpx;
  border-radius: var(--zy-radius-card);
  background: #fff;
  box-shadow: var(--zy-shadow-card);
}

.title {
  margin-bottom: 12rpx;
  color: var(--zy-text-title);
  font-size: 28rpx;
  font-weight: 600;
}

.hospital {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--zy-color-border);
}

.hospital:last-child {
  border-bottom: 0;
}

.hospital-main {
  min-width: 0;
  flex: 1;
}

.hospital-head {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.name {
  color: var(--zy-text-title);
  font-size: 27rpx;
  font-weight: 600;
}

.hospital-level,
.address {
  color: var(--zy-text-weak);
  font-size: 22rpx;
}

.address {
  margin-top: 8rpx;
  line-height: 1.45;
}

.distance {
  margin-top: 6rpx;
  color: var(--zy-color-primary);
  font-size: 22rpx;
}

.locate-tip {
  color: var(--zy-text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
  margin-top: 8rpx;
}

.locate-action {
  margin-top: 18rpx;
  padding: 16rpx 0;
  text-align: center;
  border-radius: var(--zy-radius-card);
  background: var(--zy-color-primary-soft);
  color: var(--zy-color-primary);
  font-size: 24rpx;
  transition: transform var(--zy-motion-fast) var(--zy-ease-out);
}

.locate-action:active {
  transform: scale(0.98);
}

.choose {
  flex: 0 0 auto;
  padding: 10rpx 22rpx;
  border-radius: var(--zy-radius-card);
  background: var(--zy-color-primary);
  color: #fff;
  font-size: 23rpx;
  transition: transform var(--zy-motion-fast) var(--zy-ease-out);
}

.choose:active {
  transform: scale(0.98);
}

.empty {
  padding: 24rpx 0;
  text-align: center;
  color: var(--zy-text-weak);
  font-size: 22rpx;
}
