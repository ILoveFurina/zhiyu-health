.card {
  margin: 16rpx 0;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.title {
  margin-bottom: 12rpx;
  color: #1a1a1a;
  font-size: 28rpx;
  font-weight: 600;
}

.hospital {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.hospital:last-child {
  border-bottom: 0;
}

.hospital-main {
  min-width: 0;
  flex: 1;
}

.hospital-head {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.name {
  color: #222;
  font-size: 27rpx;
  font-weight: 600;
}

.hospital-level,
.address {
  color: #999;
  font-size: 22rpx;
}

.address {
  margin-top: 8rpx;
  line-height: 1.45;
}

.distance {
  margin-top: 6rpx;
  color: #0e8a7d;
  font-size: 22rpx;
}

.locate-tip {
  color: #666;
  font-size: 24rpx;
  line-height: 1.6;
  margin-top: 8rpx;
}

.locate-action {
  margin-top: 18rpx;
  padding: 16rpx 0;
  text-align: center;
  border-radius: 24rpx;
  background: #e9f6f2;
  color: #0e8a7d;
  font-size: 24rpx;
}

.choose {
  flex: 0 0 auto;
  padding: 10rpx 22rpx;
  border-radius: 26rpx;
  background: #0e8a7d;
  color: #fff;
  font-size: 23rpx;
}

.empty {
  padding: 24rpx 0;
  text-align: center;
  color: #999;
  font-size: 22rpx;
}
