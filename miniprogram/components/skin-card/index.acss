.skin-card {
  background: #fff;
  border-radius: var(--zy-radius-sm);
  padding: 24rpx;
  box-shadow: var(--zy-shadow-card);
}

.skin-card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--zy-text-title);
  margin-bottom: 16rpx;
}

.skin-type {
  font-size: 28rpx;
  color: var(--zy-text-title);
  margin-bottom: 16rpx;
}

.findings {
  margin-bottom: 16rpx;
}

.finding {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--zy-color-border);
}

.finding:last-child {
  border-bottom: none;
}

.finding-head {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.severity-label {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--zy-radius-sm);
  margin-right: 16rpx;
  color: #fff;
}

.severity-green {
  background: var(--zy-color-primary);
}

.severity-yellow {
  background: var(--zy-color-warning);
}

.severity-red {
  background: var(--zy-color-danger);
}

.finding-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--zy-text-title);
}

.finding-text {
  font-size: 26rpx;
  color: var(--zy-text-secondary);
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.finding-advice {
  font-size: 26rpx;
  color: var(--zy-color-primary);
  line-height: 1.5;
}

.care-summary {
  font-size: 28rpx;
  color: var(--zy-text-title);
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.need-doctor {
  font-size: 26rpx;
  color: var(--zy-color-danger);
  margin-bottom: 16rpx;
}
