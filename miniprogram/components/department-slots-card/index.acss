/* 科室号源卡（票 49）：14 天日期条 + 跨医院医生号源；无号医生整卡置灰。
 * 票 62：全部类名带 ds- 前缀——支付宝组件样式不隔离，doctor-card/appointment-card
 * 的 .doctor/.slot/.specialty/.empty 等裸类名会串扰本组件布局。 */
.ds-card {
  padding: var(--zy-space-md);
  border-radius: var(--zy-radius-card);
  background: #fff;
  box-shadow: var(--zy-shadow-card);
}

.ds-head { display: flex; align-items: center; justify-content: space-between; }
.ds-head-title { display: flex; align-items: center; gap: var(--zy-space-sm); }
.ds-dept-name { color: var(--zy-text-title); font-size: 32rpx; font-weight: 700; }
.ds-dept-category {
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: var(--zy-color-primary-soft);
  color: var(--zy-color-primary);
  font-size: 20rpx;
}
/* 票 62：跳科室挂号业务页入口 */
.ds-more-dept { flex-shrink: 0; color: var(--zy-color-primary); font-size: 24rpx; }

.ds-day-scroll { margin-top: var(--zy-space-sm); width: 100%; }
.ds-day-row { display: flex; gap: var(--zy-space-xs); }
.ds-day {
  width: 96rpx;
  flex-shrink: 0;
  padding: var(--zy-space-xs) 0;
  border-radius: var(--zy-radius-sm);
  background: var(--zy-color-fill);
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform var(--zy-motion-fast) var(--zy-ease-out);
}
.ds-day:active { transform: scale(0.98); }
.ds-day-active { background: var(--zy-color-primary); }
.ds-day-active .ds-day-week, .ds-day-active .ds-day-label { color: #fff; }
.ds-day-week { color: var(--zy-text-secondary); font-size: 20rpx; }
.ds-day-label { margin-top: 4rpx; color: var(--zy-text-title); font-size: 24rpx; font-weight: 600; }
.ds-day-dot { margin-top: 4rpx; width: 8rpx; height: 8rpx; border-radius: 50%; background: transparent; }
.ds-day-dot-on { background: var(--zy-color-primary); }
.ds-day-active .ds-day-dot-on { background: #fff; }

.ds-empty { padding: var(--zy-space-xl) 0; color: var(--zy-text-weak); font-size: 24rpx; text-align: center; }

.ds-doctor {
  margin-top: var(--zy-space-sm);
  padding: var(--zy-space-sm);
  border-radius: var(--zy-radius-sm);
  border: 1rpx solid var(--zy-color-border);
}
.ds-doctor-disabled { opacity: 0.55; }
/* 票 62：医生信息与时段行全部禁止换行，窄卡片宽度下不再逐字竖排 */
.ds-doctor-head { display: flex; align-items: center; gap: var(--zy-space-sm); }
/* 头像（票 62，与 doctor-card 票 59 同套路）：photo_url 为 /api/c/photos 代理 URL，加载失败降级姓氏圆 */
.ds-avatar {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--zy-color-primary-soft);
}
.ds-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--zy-color-primary);
  font-size: 30rpx;
  font-weight: 600;
}
.ds-doctor-name-row {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: var(--zy-space-sm);
  white-space: nowrap;
}
.ds-doctor-name { color: var(--zy-text-title); font-size: 28rpx; font-weight: 700; }
.ds-doctor-title { color: var(--zy-text-secondary); font-size: 22rpx; }
.ds-doctor-fee { flex-shrink: 0; color: var(--zy-color-primary); font-size: 26rpx; font-weight: 600; }
.ds-doctor-hospital {
  margin-top: 6rpx;
  color: var(--zy-text-secondary);
  font-size: 23rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
/* 擅长（票 60）：仿 booking/doctors 列表，次要色 2 行省略；specialty 为 null 时不渲染 */
.ds-specialty {
  margin-top: 6rpx;
  color: var(--zy-text-secondary);
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.ds-doctor-address {
  margin-top: 4rpx;
  color: var(--zy-text-weak);
  font-size: 22rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.ds-slots { margin-top: var(--zy-space-sm); }
.ds-slot {
  padding: var(--zy-space-xs) 0;
  border-top: 1rpx solid var(--zy-color-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.ds-slot-info { display: flex; align-items: center; gap: var(--zy-space-sm); white-space: nowrap; }
.ds-slot-time { color: var(--zy-text-title); font-size: 26rpx; font-weight: 600; }
.ds-slot-remaining { flex-shrink: 0; color: var(--zy-text-secondary); font-size: 22rpx; white-space: nowrap; }
.ds-slot-remaining-none { color: var(--zy-text-weak); }
.ds-slot-book {
  flex-shrink: 0;
  padding: 8rpx 32rpx;
  border-radius: 999rpx;
  background: var(--zy-color-primary);
  color: #fff;
  font-size: 24rpx;
  transition: transform var(--zy-motion-fast) var(--zy-ease-out);
}
.ds-slot-book:active { transform: scale(0.98); }
.ds-slot-book-disabled { background: var(--zy-color-fill); color: var(--zy-text-weak); }
.ds-slot-empty { padding: var(--zy-space-sm) 0; color: var(--zy-text-weak); font-size: 22rpx; }

.ds-no-book {
  margin-top: var(--zy-space-sm);
  padding: var(--zy-space-sm) 0;
  border-radius: var(--zy-radius-sm);
  background: var(--zy-color-fill);
  color: var(--zy-text-weak);
  font-size: 24rpx;
  text-align: center;
}
