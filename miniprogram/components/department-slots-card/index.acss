/* 科室号源卡（票 49）：14 天日期条 + 跨医院医生号源；无号医生整卡置灰 */
.slots-card {
  padding: var(--zy-space-md);
  border-radius: var(--zy-radius-card);
  background: #fff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.06);
}

.head { display: flex; align-items: center; gap: var(--zy-space-sm); }
.dept-name { color: var(--zy-text-title); font-size: 32rpx; font-weight: 700; }
.dept-category {
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: var(--zy-color-primary-soft);
  color: var(--zy-color-primary);
  font-size: 20rpx;
}

.day-scroll { margin-top: var(--zy-space-sm); width: 100%; }
.day-row { display: flex; gap: var(--zy-space-xs); }
.day {
  width: 96rpx;
  flex-shrink: 0;
  padding: var(--zy-space-xs) 0;
  border-radius: 16rpx;
  background: #f4f7f6;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.day-active { background: var(--zy-color-primary); }
.day-active .day-week, .day-active .day-label { color: #fff; }
.day-week { color: var(--zy-text-secondary); font-size: 20rpx; }
.day-label { margin-top: 4rpx; color: var(--zy-text-title); font-size: 24rpx; font-weight: 600; }
.day-dot { margin-top: 4rpx; width: 8rpx; height: 8rpx; border-radius: 50%; background: transparent; }
.day-dot-on { background: var(--zy-color-primary); }
.day-active .day-dot-on { background: #fff; }

.empty { padding: var(--zy-space-xl) 0; color: var(--zy-text-weak); font-size: 24rpx; text-align: center; }

.doctor {
  margin-top: var(--zy-space-sm);
  padding: var(--zy-space-sm);
  border-radius: 16rpx;
  border: 1rpx solid #eef3f1;
}
.doctor-disabled { opacity: 0.55; }
.doctor-head { display: flex; align-items: center; justify-content: space-between; }
.doctor-name-row { display: flex; align-items: center; gap: var(--zy-space-sm); }
.doctor-name { color: var(--zy-text-title); font-size: 28rpx; font-weight: 700; }
.doctor-title { color: var(--zy-text-secondary); font-size: 22rpx; }
.doctor-fee { color: var(--zy-color-primary); font-size: 26rpx; font-weight: 600; }
.doctor-hospital { margin-top: 6rpx; color: var(--zy-text-secondary); font-size: 23rpx; }
/* 擅长（票 60）：仿 booking/doctors 列表，次要色 2 行省略；specialty 为 null 时不渲染 */
.specialty {
  margin-top: 6rpx;
  color: var(--zy-text-secondary);
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.doctor-address { margin-top: 4rpx; color: var(--zy-text-weak); font-size: 22rpx; }

.slots { margin-top: var(--zy-space-sm); }
.slot {
  padding: var(--zy-space-xs) 0;
  border-top: 1rpx solid #f2f5f4;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.slot-info { display: flex; align-items: center; gap: var(--zy-space-sm); }
.slot-time { color: var(--zy-text-title); font-size: 26rpx; font-weight: 600; }
.slot-remaining { color: var(--zy-text-secondary); font-size: 22rpx; }
.slot-remaining-none { color: var(--zy-text-weak); }
.slot-book {
  padding: 8rpx 32rpx;
  border-radius: 999rpx;
  background: var(--zy-color-primary);
  color: #fff;
  font-size: 24rpx;
}
.slot-book-disabled { background: #f2f5f4; color: var(--zy-text-weak); }
.slot-empty { padding: var(--zy-space-sm) 0; color: var(--zy-text-weak); font-size: 22rpx; }

.no-book {
  margin-top: var(--zy-space-sm);
  padding: var(--zy-space-sm) 0;
  border-radius: 16rpx;
  background: #f2f5f4;
  color: var(--zy-text-weak);
  font-size: 24rpx;
  text-align: center;
}
