.card {
  margin: 16rpx 0;
  padding: 24rpx;
  border-radius: var(--zy-radius-card);
  background: #fff;
  box-shadow: var(--zy-shadow-card);
}

.title {
  margin-bottom: 12rpx;
  color: var(--zy-text-title);
  font-size: 28rpx;
  font-weight: 600;
}

.doctor,
.slot {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--zy-color-border);
}

.doctor:last-child,
.slot:last-child {
  border-bottom: 0;
}

.avatar {
  width: 92rpx;
  height: 92rpx;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--zy-color-primary-soft);
}

/* 头像加载失败降级文字圆（票 59） */
.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--zy-color-primary);
  font-size: 32rpx;
  font-weight: 600;
}

.doctor-main {
  min-width: 0;
  flex: 1;
}

.doctor-head {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.name,
.slot-date {
  color: var(--zy-text-title);
  font-size: 27rpx;
  font-weight: 600;
}

.doctor-title,
.specialty,
.availability,
.empty {
  color: var(--zy-text-weak);
  font-size: 22rpx;
}

.specialty {
  margin-top: 8rpx;
  line-height: 1.45;
}

.availability {
  margin-top: 6rpx;
  color: var(--zy-color-primary);
}

.choose {
  flex: 0 0 auto;
  padding: 10rpx 22rpx;
  border-radius: var(--zy-radius-card);
  background: var(--zy-color-primary);
  color: #fff;
  font-size: 23rpx;
  transition: transform var(--zy-motion-fast) var(--zy-ease-out);
}

.choose:active {
  transform: scale(0.98);
}

.empty {
  padding: 24rpx 0;
  text-align: center;
}
