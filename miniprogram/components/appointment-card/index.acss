.card {
  margin: 16rpx 0;
  padding: 24rpx;
  border-radius: var(--zy-radius-card);
  background: #fff;
  box-shadow: var(--zy-shadow-card);
}

.success-title {
  color: var(--zy-color-primary);
  font-size: 29rpx;
  font-weight: 600;
}

.appointment {
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--zy-color-border);
}

.appointment:last-child {
  border-bottom: 0;
}

.doctor {
  color: var(--zy-text-title);
  font-size: 27rpx;
  font-weight: 600;
}

.meta,
.payment,
.summary,
.empty {
  margin-top: 8rpx;
  color: var(--zy-text-weak);
  font-size: 23rpx;
  line-height: 1.5;
}

.payment {
  color: var(--zy-color-warning);
  font-weight: 600;
}

.summary-notice {
  display: inline-block;
  margin-top: 14rpx;
  padding: 8rpx 14rpx;
  border-radius: var(--zy-radius-sm);
  background: var(--zy-color-primary-soft);
  color: var(--zy-color-primary);
  font-size: 23rpx;
}
