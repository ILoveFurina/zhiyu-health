/* 购药结果卡（票 79）：与 drug-orders 列表页同族视觉，类名带 dor- 前缀避免组件样式串扰。
 * 状态色取契约 status 值（票 88 九值：UNPAID/PAID/DISPENSING/SHIPPED/DELIVERED/
 * READY_FOR_PICKUP/PICKED_UP/CANCELLED/EXPIRED），与列表页 .status-* 同口径。 */
.dor-card {
  padding: var(--zy-space-md);
  border-radius: var(--zy-radius-card);
  background: #fff;
  box-shadow: var(--zy-shadow-card);
}

.dor-head { display: flex; align-items: center; justify-content: space-between; }
.dor-kicker { color: var(--zy-text-weak); font-size: 20rpx; }
.dor-title { color: var(--zy-text-title); font-size: 29rpx; font-weight: 700; }
.dor-status {
  padding: 7rpx 18rpx;
  border-radius: 999rpx;
  background: var(--zy-color-primary-soft);
  color: var(--zy-color-primary);
  font-size: 21rpx;
  font-weight: 600;
}
.dor-status-UNPAID { background: var(--zy-color-warning-soft); color: var(--zy-color-warning); }
.dor-status-CANCELLED { background: var(--zy-color-danger-soft); color: var(--zy-color-danger); }
.dor-status-EXPIRED { background: var(--zy-color-danger-soft); color: var(--zy-color-danger); }
.dor-status-DELIVERED { background: var(--zy-color-primary-soft); color: var(--zy-color-primary); }
.dor-status-PICKED_UP { background: var(--zy-color-primary-soft); color: var(--zy-color-primary); }

.dor-meta {
  margin-top: var(--zy-space-sm);
  padding: var(--zy-space-sm);
  border-radius: var(--zy-radius-sm);
  background: var(--zy-color-fill);
  color: var(--zy-text-secondary);
  font-size: 22rpx;
  line-height: 1.8;
}
.dor-meta-label { display: inline-block; width: 120rpx; color: var(--zy-text-weak); }

.dor-items { margin-top: var(--zy-space-sm); }
.dor-item {
  margin-top: var(--zy-space-sm);
  padding: var(--zy-space-sm);
  border-radius: var(--zy-radius-sm);
  border: 1rpx solid var(--zy-color-border);
  color: var(--zy-text-title);
  font-size: 24rpx;
}
.dor-item:first-child { margin-top: 0; }
.dor-item-name { font-weight: 600; }
.dor-item-spec { margin-top: 4rpx; color: var(--zy-text-weak); font-size: 21rpx; }
.dor-item-price {
  margin-top: var(--zy-space-xs);
  color: var(--zy-text-secondary);
  display: flex;
  justify-content: space-between;
}
.dor-item-subtotal { color: var(--zy-text-title); font-weight: 600; }

.dor-amounts { margin-top: var(--zy-space-sm); }
.dor-amount-row {
  display: flex;
  justify-content: space-between;
  color: var(--zy-text-secondary);
  font-size: 24rpx;
}
.dor-amount-label { color: var(--zy-text-weak); }

.dor-total {
  margin-top: var(--zy-space-xs);
  padding-top: var(--zy-space-sm);
  border-top: 1rpx solid var(--zy-color-border);
  color: var(--zy-text-title);
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  justify-content: space-between;
}
.dor-total-label { color: var(--zy-text-secondary); font-size: 23rpx; font-weight: 400; }

.dor-btn {
  margin-top: var(--zy-space-sm);
  padding: 18rpx 0;
  border-radius: var(--zy-radius-lg);
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  transition: transform var(--zy-motion-fast) var(--zy-ease-out);
}
.dor-btn:active { transform: scale(0.98); }
.dor-btn-detail { border: 1rpx solid var(--zy-color-primary); color: var(--zy-color-primary); background: var(--zy-color-primary-soft); }
