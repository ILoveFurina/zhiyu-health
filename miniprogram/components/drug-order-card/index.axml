<view class="dor-card">
  <view class="dor-head">
    <view>
      <view class="dor-kicker">药品订单</view>
      <view class="dor-title">#{{card.id || card.order_no}}</view>
    </view>
    <view class="dor-status dor-status-{{card.status}}">{{card.status_label || card.status}}</view>
  </view>

  <view class="dor-meta">
    <view><text class="dor-meta-label">来源</text>{{card.source === 'PRESCRIPTION' ? '处方药' : '非处方药'}}</view>
    <view a:if="{{pickupLabel}}"><text class="dor-meta-label">取药方式</text>{{pickupLabel}}</view>
    <view a:if="{{card.pharmacy_name}}"><text class="dor-meta-label">履约药房</text>{{card.pharmacy_name}}</view>
    <view a:if="{{card.hospital_name}}">
      <text class="dor-meta-label">药房位置</text>{{card.hospital_name}}{{card.campus_name ? ' · ' + card.campus_name : ''}}
    </view>
  </view>

  <view class="dor-items">
    <view a:for="{{card.items}}" a:key="medication_id" class="dor-item">
      <view class="dor-item-name">{{item.name}}</view>
      <view a:if="{{item.specification}}" class="dor-item-spec">{{item.specification}}</view>
      <view class="dor-item-price">
        <text>¥{{item.unit_price}} × {{item.quantity}}</text>
        <text class="dor-item-subtotal">¥{{item.subtotal}}</text>
      </view>
    </view>
  </view>

  <view class="dor-amounts">
    <view a:if="{{card.delivery_fee != null}}" class="dor-amount-row">
      <text class="dor-amount-label">配送费</text><text>¥{{card.delivery_fee}}</text>
    </view>
    <view class="dor-total">
      <text class="dor-total-label">订单合计</text>
      <text>¥{{card.total_amount}}</text>
    </view>
  </view>

  <view class="dor-btn dor-btn-detail" onTap="openDetail">查看订单详情</view>
</view>
