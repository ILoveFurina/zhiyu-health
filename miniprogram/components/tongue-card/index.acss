.tongue-card {
  background: #fff;
  border-radius: var(--zy-radius-sm);
  padding: 24rpx;
  box-shadow: var(--zy-shadow-card);
}

.tongue-card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--zy-text-title);
  margin-bottom: 16rpx;
}

.constitution {
  font-size: 28rpx;
  color: var(--zy-text-title);
  margin-bottom: 8rpx;
}

.tongue-features {
  font-size: 26rpx;
  color: var(--zy-text-secondary);
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.section-label {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--zy-color-primary);
  margin-bottom: 8rpx;
}

.care-direction {
  font-size: 28rpx;
  color: var(--zy-text-title);
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.diet-principle {
  font-size: 28rpx;
  color: var(--zy-text-title);
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.urgency-hint {
  font-size: 26rpx;
  color: var(--zy-color-warning);
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.need-doctor {
  font-size: 26rpx;
  color: var(--zy-color-danger);
  margin-bottom: 16rpx;
}
