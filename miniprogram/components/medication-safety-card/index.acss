.med-safety-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.med-safety-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}

.decision-row {
  margin-bottom: 16rpx;
}

.decision-badge {
  display: inline-block;
  font-size: 26rpx;
  font-weight: 600;
  padding: 8rpx 24rpx;
  border-radius: 8rpx;
}

.badge-blocked {
  background: #fff1f0;
  color: #ff4d4f;
}

.badge-review {
  background: #fffbe6;
  color: #faad14;
}

.badge-safe {
  background: #f6ffed;
  color: #52c41a;
}

.safety-message {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.reasons {
  background: #fafafa;
  border-radius: 8rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.reasons-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #666;
  margin-bottom: 8rpx;
}

.reason-item {
  font-size: 26rpx;
  color: #555;
  line-height: 1.5;
  margin-bottom: 4rpx;
}

.advice-box {
  background: #e6f7ff;
  border-left: 6rpx solid #1890ff;
  border-radius: 4rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.advice-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #1890ff;
  margin-bottom: 8rpx;
}

.advice-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
}

.consult-hint {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 16rpx;
}
