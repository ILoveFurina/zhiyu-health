<view class="page">
  <view a:if="{{loading}}" class="state">正在加载…</view>
  <view a:elif="{{messages.length === 0 && reminders.length === 0}}" class="state">暂无站内消息</view>
  <block a:else>
    <view a:if="{{reminders.length > 0}}" class="section-title">服药提醒</view>
    <view a:for="{{reminders}}" a:key="id" class="card reminder">
      <view class="head">
        <view class="title">{{item.medication_name}}</view>
        <view class="time">{{item.due_date}}</view>
      </view>
      <view class="content">{{item.dosage}} · {{item.frequency}}</view>
      <view class="reminder-action">
        <button class="checkin-btn" data-id="{{item.id}}" onTap="onCheckIn">已服用</button>
      </view>
      <ai-disclaimer text="{{item.disclaimer}}" />
    </view>
    <view a:if="{{messages.length > 0}}" class="section-title">站内消息</view>
    <view a:for="{{messages}}" a:key="id" class="card">
      <view class="head"><view class="title">{{item.title}}</view><view class="time">{{item.created_at}}</view></view>
      <view class="content">{{item.content}}</view>
      <ai-disclaimer text="{{item.disclaimer}}" />
    </view>
  </block>
</view>
