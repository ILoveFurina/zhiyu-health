<view class="page">
  <!-- 骨架屏（票 66）：数据到达前按消息卡形态渲染 4 行占位 -->
  <block a:if="{{loading}}">
    <view a:for="{{skelItems}}" a:key="*this" class="zy-skel-card skel-row">
      <view class="zy-skel zy-skel-circle" style="width: 72rpx; height: 72rpx;"></view>
      <view class="skel-lines">
        <view class="zy-skel zy-skel-line" style="width: 55%;"></view>
        <view class="zy-skel zy-skel-line skel-line-gap" style="width: 85%;"></view>
      </view>
    </view>
  </block>
  <zy-empty a:elif="{{messages.length === 0 && reminders.length === 0}}" icon="mail" text="暂无站内消息" />
  <block a:else>
    <view a:if="{{reminders.length > 0}}" class="section-title">服药提醒</view>
    <view a:for="{{reminders}}" a:key="id" class="card reminder zy-fade-in" style="animation-delay: {{index * 40}}ms">
      <view class="head">
        <view class="title">{{item.medication_name}}</view>
        <view class="time">{{item.due_date}}</view>
      </view>
      <view class="content">{{item.dosage}} · {{item.frequency}}</view>
      <view class="reminder-action">
        <button class="checkin-btn" data-id="{{item.id}}" onTap="onCheckIn">已服用</button>
      </view>
      <ai-disclaimer text="{{item.disclaimer}}" />
    </view>
    <view a:if="{{messages.length > 0}}" class="section-title">站内消息</view>
    <view
      a:for="{{messages}}"
      a:key="id"
      class="card message-card {{item.isUnread ? 'message-unread' : 'message-read'}} zy-fade-in"
      style="animation-delay: {{index * 40}}ms"
      data-id="{{item.id}}"
      onTap="onMessageTap"
    >
      <view class="head">
        <view a:if="{{item.isUnread}}" class="unread-dot"></view>
        <view class="title">{{item.title}}</view>
        <view a:if="{{item.isUnread}}" class="unread-label">未读</view>
        <view class="time">{{item.created_at}}</view>
      </view>
      <!-- 就诊指引卡（票 43）：appointment_care 渲染结构化卡片，其余 type 走文本 -->
      <block a:if="{{item.type === 'appointment_care' && item.care}}">
        <view class="care-greeting">{{item.care.greeting}}</view>
        <view class="care-row"><text class="care-label">医院</text><text class="care-value">{{item.care.hospital_name}}</text></view>
        <view class="care-row"><text class="care-label">科室</text><text class="care-value">{{item.care.department_name}}</text></view>
        <view class="care-row"><text class="care-label">医生</text><text class="care-value">{{item.care.doctor_name}}</text></view>
        <view class="care-row"><text class="care-label">时间</text><text class="care-value">{{item.care.schedule_time}}</text></view>
        <view class="care-row"><text class="care-label">地址</text><text class="care-value">{{item.care.address}}</text></view>
        <view class="care-row"><text class="care-label">楼层</text><text class="care-value">{{item.care.floor}}</text></view>
        <view a:if="{{item.care.materials.length > 0}}" class="care-block">
          <view class="care-block-title">携带材料</view>
          <view a:for="{{item.care.materials}}" a:for-item="m" a:key="*this" class="care-list-item">· {{m}}</view>
        </view>
        <view a:if="{{item.care.precautions.length > 0}}" class="care-block">
          <view class="care-block-title">注意事项</view>
          <view a:for="{{item.care.precautions}}" a:for-item="p" a:key="*this" class="care-list-item">· {{p}}</view>
        </view>
      </block>
      <block a:elif="{{item.isCallNotice && item.call}}">
        <view class="call-banner">
          <view class="call-greeting">{{item.call.greeting}}</view>
          <view class="call-number">{{item.call.sequence_number}} 号</view>
        </view>
        <view class="call-details">
          <view><text>诊室</text>{{item.call.room}}</view>
          <view><text>时段</text>{{item.call.schedule_date}} {{item.call.time_slot}}</view>
        </view>
      </block>
      <view a:else class="content">{{item.content}}</view>
      <ai-disclaimer text="{{item.disclaimer}}" />
    </view>
  </block>
</view>
