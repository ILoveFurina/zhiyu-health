.page { min-height: 100vh; padding: var(--zy-space-md); box-sizing: border-box; background: var(--zy-color-fill); }
.section-title { margin: 12rpx 4rpx 16rpx; color: var(--zy-text-title); font-size: 28rpx; font-weight: 700; }
.card { margin-bottom: 20rpx; padding: 26rpx; border-radius: var(--zy-radius-card); background: #fff; box-shadow: var(--zy-shadow-card); transition: transform var(--zy-motion-fast) var(--zy-ease-out); }
.card:active { transform: scale(0.98); }
.card.reminder { border-left: 8rpx solid var(--zy-color-primary); }
.message-card { border: 1rpx solid transparent; }
.message-unread { border-color: rgba(0, 168, 112, 0.28); box-shadow: var(--zy-shadow-raised); }
.message-read { opacity: 0.76; box-shadow: none; }
.head { display: flex; align-items: center; }
.unread-dot { width: 12rpx; height: 12rpx; flex: 0 0 auto; margin-right: 10rpx; border-radius: 50%; background: var(--zy-color-primary); }
.title { flex: 1; color: var(--zy-text-title); font-size: 30rpx; font-weight: 700; }
.unread-label { margin-right: var(--zy-space-sm); padding: 3rpx 12rpx; border-radius: 999rpx; background: var(--zy-color-primary-soft); color: var(--zy-color-primary); font-size: 18rpx; }
.time { color: var(--zy-text-weak); font-size: 20rpx; }
.content { margin-top: 18rpx; color: var(--zy-text-title); font-size: 26rpx; line-height: 1.75; }
.reminder-action { margin-top: 20rpx; display: flex; justify-content: flex-end; }
.checkin-btn { background: var(--zy-color-primary); color: #fff; font-size: 26rpx; padding: 0 36rpx; height: 64rpx; line-height: 64rpx; border-radius: var(--zy-radius-lg); border: none; transition: transform var(--zy-motion-fast) var(--zy-ease-out); }
.checkin-btn:active { transform: scale(0.98); }
/* 就诊指引卡（票 43）：结构化卡片样式 */
.care-greeting { margin-top: 16rpx; color: var(--zy-text-title); font-size: 28rpx; font-weight: 600; }
.care-row { display: flex; margin-top: 12rpx; font-size: 26rpx; line-height: 1.6; }
.care-label { flex: 0 0 96rpx; color: var(--zy-text-weak); }
.care-value { flex: 1; color: var(--zy-text-title); }
.care-block { margin-top: 16rpx; }
.care-block-title { color: var(--zy-text-title); font-size: 26rpx; font-weight: 600; margin-bottom: 6rpx; }
.care-list-item { color: var(--zy-text-title); font-size: 25rpx; line-height: 1.7; }
.call-banner { display: flex; align-items: center; margin-top: 18rpx; padding: 20rpx; border-radius: var(--zy-radius-sm); background: var(--zy-color-primary-soft); }
.call-greeting { flex: 1; color: var(--zy-text-title); font-size: 26rpx; font-weight: 600; line-height: 1.5; }
.call-number { margin-left: 16rpx; color: var(--zy-color-primary); font-size: 40rpx; font-weight: 750; white-space: nowrap; }
.call-details { margin-top: 14rpx; color: var(--zy-text-title); font-size: 25rpx; line-height: 1.8; }
.call-details text { display: inline-block; width: 82rpx; color: var(--zy-text-weak); }
/* 骨架屏（票 66）：左 72rpx 圆 + 右两行，形态对齐消息卡 */
.skel-row { display: flex; align-items: center; }
.skel-lines { flex: 1; margin-left: var(--zy-space-md); }
.skel-line-gap { margin-top: var(--zy-space-sm); }
