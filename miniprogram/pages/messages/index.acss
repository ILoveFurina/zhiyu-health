.page { min-height: 100vh; padding: var(--zy-space-md); box-sizing: border-box; background: #f3f7f6; }
.state { padding-top: 180rpx; text-align: center; color: var(--zy-text-weak); }
.card { margin-bottom: 20rpx; padding: 26rpx; border-radius: var(--zy-radius-card); background: #fff; box-shadow: 0 2rpx 10rpx rgba(0,0,0,.06); }
.head { display: flex; align-items: center; }
.title { flex: 1; color: var(--zy-text-title); font-size: 30rpx; font-weight: 700; }
.time { color: var(--zy-text-weak); font-size: 20rpx; }
.content { margin-top: 18rpx; color: var(--zy-text-title); font-size: 26rpx; line-height: 1.75; }
