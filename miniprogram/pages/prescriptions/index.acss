.page { min-height: 100vh; padding: var(--zy-space-md); box-sizing: border-box; background: var(--zy-color-fill); }
.orders-link { margin-bottom: 20rpx; padding: 18rpx; border-radius: var(--zy-radius-sm); background: var(--zy-color-primary-soft); color: var(--zy-color-primary); font-size: 25rpx; text-align: center; }
.card { margin-bottom: 22rpx; padding: 26rpx; border-radius: var(--zy-radius-card); background: #fff; box-shadow: var(--zy-shadow-card); transition: transform var(--zy-motion-fast) var(--zy-ease-out); }
.card:active { transform: scale(0.98); }
.title { color: var(--zy-text-title); font-size: 31rpx; font-weight: 700; }
.title-row { display: flex; align-items: center; justify-content: space-between; }
/* 状态徽标（票 60）：已通过=主色、待审核=橙、已驳回=红，色系与既有 terminal-bar 提示一致 */
.status-tag { margin-left: 12rpx; padding: 2rpx 14rpx; border-radius: var(--zy-radius-sm); font-size: 20rpx; flex-shrink: 0; }
.status-approved { background: var(--zy-color-primary-soft); color: var(--zy-color-primary); }
.status-pending { background: var(--zy-color-warning-soft); color: var(--zy-color-warning); }
.status-rejected { background: var(--zy-color-danger-soft); color: var(--zy-color-danger); }
.meta { margin-top: var(--zy-space-xs); color: var(--zy-text-secondary); font-size: 23rpx; }
.source-tag { margin-left: 12rpx; padding: 2rpx 12rpx; border-radius: var(--zy-radius-sm); background: var(--zy-color-primary-soft); color: var(--zy-color-primary); font-size: 20rpx; }
.drug { margin-top: 18rpx; padding: 18rpx; border-radius: var(--zy-radius-sm); background: var(--zy-color-primary-soft); color: var(--zy-text-secondary); font-size: 24rpx; line-height: 1.7; }
.drug-name, .interpretation-title { color: var(--zy-text-title); font-weight: 600; }
.interpretation-title { margin-top: 22rpx; }
.interpretation { margin-top: var(--zy-space-xs); color: var(--zy-text-title); font-size: 25rpx; line-height: 1.7; }
.pharmacy { margin-top: 20rpx; color: var(--zy-text-secondary); font-size: 23rpx; }
.order { margin-top: var(--zy-space-sm); border: 0; border-radius: var(--zy-radius-lg); background: var(--zy-color-primary); color: #fff; font-size: 26rpx; }
/* 票 88：配药数量只读展示（医生开方决定）；已核销处方提示不可重复下单 */
.quantity-text { margin-top: 8rpx; color: var(--zy-text-title); font-size: 23rpx; }
.redeemed-hint { margin-top: var(--zy-space-sm); color: var(--zy-text-weak); font-size: 23rpx; text-align: center; }
/* 待审核/已驳回卡内说明与引导（票 60） */
.pending-hint { margin-top: 18rpx; color: var(--zy-text-secondary); font-size: 23rpx; }
.reject-reason { margin-top: 18rpx; padding: 16rpx; border-radius: var(--zy-radius-sm); background: var(--zy-color-danger-soft); color: var(--zy-color-danger); font-size: 23rpx; line-height: 1.6; }
.reject-hint { margin-top: 14rpx; color: var(--zy-text-secondary); font-size: 23rpx; line-height: 1.6; }
.reject-actions { display: flex; gap: 16rpx; margin-top: 16rpx; }
.reject-btn { flex: 1; padding: 14rpx 0; border-radius: var(--zy-radius-lg); background: var(--zy-color-primary-soft); color: var(--zy-color-primary); font-size: 25rpx; text-align: center; }
/* 骨架屏（票 66）：三行条，形态对齐处方卡标题/明细/解读 */
.skel-line-gap { margin-top: var(--zy-space-sm); }
