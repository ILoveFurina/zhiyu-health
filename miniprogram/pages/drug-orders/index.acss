.page { min-height: 100vh; padding: 24rpx; box-sizing: border-box; background: #f3f7f6; }
.state { padding-top: 180rpx; color: #999; font-size: 26rpx; text-align: center; }
.card { margin-bottom: 22rpx; padding: 26rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 2rpx 10rpx rgba(0,0,0,.06); }
.head { display: flex; align-items: center; justify-content: space-between; }
.title { color: #173f3a; font-size: 29rpx; font-weight: 700; }
.status { color: #0e8a7d; font-size: 23rpx; }
.meta { margin-top: 10rpx; color: #888; font-size: 22rpx; }
.drug { margin-top: 18rpx; padding: 16rpx; border-radius: 14rpx; background: #f4faf8; color: #344845; font-size: 24rpx; }
.price { margin-top: 8rpx; color: #6f8581; }
.total { margin-top: 20rpx; color: #173f3a; font-size: 28rpx; font-weight: 700; text-align: right; }
.cancel { margin-top: 18rpx; border: 1rpx solid #d94b4b; border-radius: 30rpx; background: #fff; color: #d94b4b; font-size: 25rpx; }
