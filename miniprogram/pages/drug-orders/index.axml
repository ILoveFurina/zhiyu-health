<view class="page">
  <view a:if="{{loading}}" class="state">正在加载…</view>
  <zy-empty a:elif="{{orders.length === 0}}" icon="capsule" text="暂无药品订单" />
  <view a:for="{{orders}}" a:key="id" class="card zy-fade-in" style="animation-delay: {{index * 40}}ms">
    <view class="head">
      <view class="title">药品订单 #{{item.id}}</view>
      <view class="status status-{{item.status}}">{{item.status_label}}</view>
    </view>
    <view class="meta">电子处方 #{{item.prescription_id}} · {{item.created_at}}</view>
    <view a:for="{{item.items}}" a:for-item="drug" a:key="medication_id" class="drug">
      <view>{{drug.name}} {{drug.specification}}</view>
      <view class="price">¥{{drug.unit_price}} × {{drug.quantity}} = ¥{{drug.subtotal}}</view>
    </view>
    <view class="total">合计：¥{{item.total_amount}}</view>
    <view a:if="{{item.payable || item.cancellable}}" class="actions">
      <button a:if="{{item.payable}}" class="pay" data-id="{{item.id}}"
        loading="{{payingId === item.id}}" disabled="{{payingId === item.id || cancellingId === item.id}}" onTap="pay">
        模拟支付
      </button>
      <button a:if="{{item.cancellable}}" class="cancel" data-id="{{item.id}}"
        loading="{{cancellingId === item.id}}" disabled="{{cancellingId === item.id || payingId === item.id}}" onTap="cancel">
        取消订单
      </button>
    </view>
  </view>
</view>
