/* 首页：白色圆角卡片浮在薄荷渐变背景上，全部消费 app.acss 的设计 token */
.page { min-height: 100vh; padding: var(--zy-space-md); box-sizing: border-box; }

@keyframes zy-home-rise {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.zy-home-enter {
  animation: zy-home-rise var(--zy-motion-slow) var(--zy-ease-out) both;
}

/* 问候头 */
.header { position: relative; padding: var(--zy-space-xs) var(--zy-space-xs) 0; }
.greeting { color: var(--zy-text-title); font-size: 44rpx; font-weight: 700; }
.greeting-sub { margin-top: var(--zy-space-xs); color: var(--zy-text-secondary); font-size: 26rpx; }

/* 消息中心入口（票 93）：右上角绝对定位不挤布局流，padding 放大触摸热区 */
.msg-bell {
  position: absolute;
  top: var(--zy-space-xs);
  right: var(--zy-space-xs);
  padding: var(--zy-space-xs);
}
.msg-bell-icon { color: var(--zy-text-title); font-size: 44rpx; }
.msg-bell-badge {
  position: absolute;
  top: 0;
  right: 0;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: var(--zy-color-danger);
  color: #fff;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
}

.profile-chip {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  margin-top: var(--zy-space-sm);
  padding: 10rpx 22rpx 10rpx 12rpx;
  border-radius: 999rpx;
  background: var(--zy-color-primary-soft);
  transition: transform var(--zy-motion-fast) var(--zy-ease-out);
}
.profile-chip:active { transform: scale(0.98); }
.chip-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--zy-color-primary);
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.chip-name { color: var(--zy-text-title); font-size: 26rpx; font-weight: 600; }
.chip-arrow { color: var(--zy-color-primary); font-size: 24rpx; }

.profile-guide {
  margin-top: var(--zy-space-sm);
  padding: var(--zy-space-md);
  border-radius: var(--zy-radius-card);
  background: #fff;
  box-shadow: var(--zy-shadow-card);
  display: flex;
  align-items: center;
  transition: transform var(--zy-motion-fast) var(--zy-ease-out);
}
.profile-guide:active { transform: scale(0.98); }
.profile-guide-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--zy-color-primary-soft);
  color: var(--zy-color-primary);
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.profile-guide-copy { flex: 1; margin-left: var(--zy-space-sm); }
.profile-guide-title { color: var(--zy-text-title); font-size: 29rpx; font-weight: 600; }
.profile-guide-text { margin-top: 6rpx; color: var(--zy-text-secondary); font-size: 23rpx; }
.profile-guide-arrow { color: var(--zy-text-weak); font-size: 36rpx; }

/* 宫格 */
.section { margin-top: var(--zy-space-lg); }
.section-title { margin: 0 var(--zy-space-xs) var(--zy-space-sm); color: var(--zy-text-title); font-size: 30rpx; font-weight: 700; }
.card {
  padding: var(--zy-space-md) var(--zy-space-sm);
  border-radius: var(--zy-radius-card);
  background: #fff;
  box-shadow: var(--zy-shadow-card);
}
.grid { display: flex; flex-wrap: wrap; }
.grid-2 .grid-item { width: 50%; }
.grid-4 .grid-item { width: 25%; }
.grid-item { box-sizing: border-box; padding: var(--zy-space-sm) var(--zy-space-xs); display: flex; flex-direction: column; align-items: center; transition: transform var(--zy-motion-fast) var(--zy-ease-out); }
.grid-item:active { transform: scale(0.98); }
.grid-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--zy-radius-lg);
  background: var(--zy-color-primary-soft);
  color: var(--zy-color-primary);
  font-size: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.grid-label { margin-top: 12rpx; color: var(--zy-text-title); font-size: 26rpx; font-weight: 600; }
.grid-desc { margin-top: 4rpx; color: var(--zy-text-weak); font-size: 22rpx; }

/* 待办横卡 */
.todo-scroll { width: 100%; }
.todo-row { display: flex; gap: var(--zy-space-sm); padding: 0 var(--zy-space-xs) var(--zy-space-xs); box-sizing: border-box; }
.todo-card {
  width: 420rpx;
  flex-shrink: 0;
  padding: var(--zy-space-md);
  box-sizing: border-box;
  border-radius: var(--zy-radius-card);
  background: #fff;
  box-shadow: var(--zy-shadow-card);
  transition: transform var(--zy-motion-fast) var(--zy-ease-out);
}
.todo-card:active { transform: scale(0.98); }
.todo-badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: var(--zy-color-primary-soft);
  color: var(--zy-color-primary);
  font-size: 20rpx;
}
.todo-badge-pay { background: var(--zy-color-warning-soft); color: var(--zy-color-warning); } /* 待支付用琥珀色与就诊绿区分 */
.todo-badge-warn { background: var(--zy-color-warning-soft); color: var(--zy-color-warning); } /* 处方审核中：进行中的琥珀色 */
.todo-badge-danger { background: var(--zy-color-danger-soft); color: var(--zy-color-danger); } /* 就诊中：叫号后立即前往，用警示红与即将就诊绿区分 */
.todo-badge-muted { background: var(--zy-color-fill); color: var(--zy-text-secondary); } /* 处方未通过：灰色终态 */
.todo-title { margin-top: var(--zy-space-sm); color: var(--zy-text-title); font-size: 28rpx; font-weight: 600; }
.todo-meta { margin-top: 6rpx; color: var(--zy-text-secondary); font-size: 23rpx; }
.todo-hint { margin-top: 6rpx; color: var(--zy-color-danger); font-size: 22rpx; }
.todo-countdown { margin-top: 10rpx; color: var(--zy-color-warning); font-size: 22rpx; }
.todo-pay {
  display: inline-flex;
  margin-top: 14rpx;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: var(--zy-color-primary);
  color: #fff;
  font-size: 22rpx;
}
.todo-pay:active { opacity: 0.85; }

/* 档案切换弹层 */
.sheet-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  box-sizing: border-box;
  padding: var(--zy-space-md);
  padding-bottom: calc(var(--zy-space-md) + env(safe-area-inset-bottom));
  border-radius: var(--zy-radius-card) var(--zy-radius-card) 0 0;
  background: #fff;
}
.sheet-title { color: var(--zy-text-title); font-size: 30rpx; font-weight: 700; text-align: center; }
.sheet-item {
  margin-top: var(--zy-space-sm);
  padding: var(--zy-space-sm);
  border-radius: var(--zy-radius-card);
  border: 1rpx solid var(--zy-color-border);
  display: flex;
  align-items: center;
  gap: var(--zy-space-sm);
}
.sheet-item-active { border-color: var(--zy-color-primary); background: var(--zy-color-primary-soft); }
.sheet-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--zy-color-primary);
  color: #fff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sheet-name { flex: 1; color: var(--zy-text-title); font-size: 28rpx; }
.sheet-check { color: var(--zy-color-primary); font-size: 24rpx; }
.sheet-create {
  margin-top: var(--zy-space-md);
  padding: var(--zy-space-sm);
  border-radius: 999rpx;
  background: var(--zy-color-primary);
  color: #fff;
  font-size: 28rpx;
  text-align: center;
}
