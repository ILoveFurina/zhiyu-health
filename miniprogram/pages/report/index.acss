/* 报告解读入口页：上传卡片 + 解读记录列表 + 页内详情，全部消费 app.acss 设计 token */
.page { min-height: 100vh; padding: var(--zy-space-md); box-sizing: border-box; }

/* 栈根直达时的回首页入口 */
.home-entry {
  margin-bottom: var(--zy-space-sm);
  color: var(--zy-color-primary);
  font-size: 26rpx;
  font-weight: 600;
}

.card {
  padding: var(--zy-space-md);
  border-radius: var(--zy-radius-card);
  background: #fff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.06);
}

/* 上传区 */
.upload-title { color: var(--zy-text-title); font-size: 32rpx; font-weight: 700; }
.upload-sub { margin-top: var(--zy-space-xs); color: var(--zy-text-secondary); font-size: 24rpx; }
.upload-tip {
  margin-top: var(--zy-space-sm);
  padding: var(--zy-space-sm);
  border-radius: 16rpx;
  background: var(--zy-color-primary-soft);
  color: var(--zy-text-secondary);
  font-size: 22rpx;
  line-height: 1.55;
}

.upload-actions { margin-top: var(--zy-space-md); display: flex; gap: var(--zy-space-sm); }
.upload-btn {
  flex: 1;
  padding: var(--zy-space-md) var(--zy-space-xs);
  border-radius: var(--zy-radius-card);
  border: 1rpx solid var(--zy-color-primary);
  color: var(--zy-color-primary);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.upload-btn-icon { font-size: 44rpx; }
.upload-btn-label { margin-top: var(--zy-space-xs); font-size: 24rpx; }

/* 待上传清单（复用 chat 待发送报告的交互：图片可排序/移除） */
.pending { margin-top: var(--zy-space-md); }
.pending-head { display: flex; justify-content: space-between; align-items: center; }
.pending-title { color: var(--zy-text-title); font-size: 28rpx; font-weight: 600; }
.pending-count { color: var(--zy-text-weak); font-size: 22rpx; }
.pending-item {
  min-height: 64rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  align-items: center;
}
.pending-index {
  width: 36rpx;
  height: 36rpx;
  border-radius: 10rpx;
  background: var(--zy-color-primary-soft);
  color: var(--zy-color-primary);
  font-size: 20rpx;
  line-height: 36rpx;
  text-align: center;
}
.pending-name {
  flex: 1;
  margin-left: 12rpx;
  color: var(--zy-text-title);
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.order-btn, .remove-btn { padding: var(--zy-space-xs) 10rpx; color: var(--zy-text-secondary); font-size: 26rpx; }
.remove-btn { color: #c85d5d; font-size: 32rpx; }
.upload-progress { margin-top: var(--zy-space-xs); color: var(--zy-color-primary); font-size: 22rpx; }
.pending-actions { margin-top: var(--zy-space-sm); display: flex; gap: var(--zy-space-sm); }
.pending-cancel, .pending-send {
  flex: 1;
  padding: 16rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  text-align: center;
}
.pending-cancel { border: 1rpx solid var(--zy-text-weak); color: var(--zy-text-secondary); }
.pending-send { background: var(--zy-color-primary); color: #fff; }
.pending-action-disabled { opacity: 0.45; }

/* 解读记录列表 */
.section { margin-top: var(--zy-space-lg); }
.section-title { margin: 0 var(--zy-space-xs) var(--zy-space-sm); color: var(--zy-text-title); font-size: 30rpx; font-weight: 700; }
.state { padding: 80rpx 0; color: var(--zy-text-weak); font-size: 26rpx; text-align: center; }
.record { margin-bottom: var(--zy-space-sm); }
.record-head { display: flex; align-items: center; justify-content: space-between; }
.record-title { color: var(--zy-text-title); font-size: 28rpx; font-weight: 600; }
.record-status { padding: 4rpx 16rpx; border-radius: 999rpx; font-size: 20rpx; }
.status-succeeded { background: var(--zy-color-primary-soft); color: var(--zy-color-primary); }
.status-processing { background: #fdf3e3; color: #d48806; } /* 解读中用琥珀色提示等待 */
.status-failed { background: #fff0ef; color: #b5443d; }
.record-summary {
  margin-top: var(--zy-space-sm);
  color: var(--zy-text-secondary);
  font-size: 24rpx;
  line-height: 1.55;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.record-meta { margin-top: var(--zy-space-xs); color: var(--zy-text-weak); font-size: 22rpx; }
