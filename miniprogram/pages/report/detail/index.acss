/* 报告解读详情页（票 61）：样式模式复制自 report/health 页，统一消费 app.acss 设计 token */
.page { min-height: 100vh; padding: var(--zy-space-md); box-sizing: border-box; }

.card {
  margin-bottom: var(--zy-space-sm);
  padding: var(--zy-space-md);
  border-radius: var(--zy-radius-card);
  background: #fff;
  box-shadow: var(--zy-shadow-card);
}
.section { margin-top: var(--zy-space-lg); }
.section-title { margin: 0 var(--zy-space-xs) var(--zy-space-sm); color: var(--zy-text-title); font-size: 30rpx; font-weight: 700; }
.state { padding: 80rpx 0; color: var(--zy-text-weak); font-size: 26rpx; text-align: center; }

/* 头部 */
.head-row { display: flex; align-items: center; justify-content: space-between; gap: var(--zy-space-sm); }
.head-name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--zy-text-title); font-size: 30rpx; font-weight: 700; }
.record-status { padding: 4rpx 16rpx; border-radius: 999rpx; font-size: 20rpx; white-space: nowrap; }
.status-succeeded { background: var(--zy-color-primary-soft); color: var(--zy-color-primary); }
.status-processing { background: var(--zy-color-warning-soft); color: var(--zy-color-warning); }
.status-failed { background: var(--zy-color-danger-soft); color: var(--zy-color-danger); }
.head-meta { margin-top: var(--zy-space-xs); color: var(--zy-text-weak); font-size: 22rpx; }
.conv-entry { margin-top: var(--zy-space-sm); padding-top: var(--zy-space-sm); border-top: 1rpx solid var(--zy-color-border); color: var(--zy-color-primary); font-size: 24rpx; }

/* 概要与逐项指标（结构化卡片字段与 chat 会话内同款） */
.report-summary { color: var(--zy-text-title); font-size: 26rpx; line-height: 1.55; }
.finding-head { display: flex; align-items: flex-start; gap: var(--zy-space-sm); }
.finding-identity { min-width: 0; flex: 1; }
.finding-result { flex: 0 0 auto; display: flex; flex-direction: column; align-items: flex-end; gap: var(--zy-space-xs); }
.priority-label {
  padding: 3rpx 10rpx;
  border-radius: var(--zy-radius-sm);
  color: #fff;
  font-size: 18rpx;
  white-space: nowrap;
}
.priority-red { background: var(--zy-color-danger); }
.priority-yellow { background: var(--zy-color-warning); }
.priority-blue { background: #4389d8; }
.priority-green { background: var(--zy-color-primary); }
.finding-name { color: var(--zy-text-title); font-size: 27rpx; font-weight: 700; }
.finding-value { color: var(--zy-text-title); font-size: 30rpx; font-weight: 700; }
.finding-ref { margin-top: 6rpx; color: var(--zy-text-weak); font-size: 20rpx; }
.state-badge {
  display: inline-block;
  margin-top: var(--zy-space-xs);
  padding: 3rpx 12rpx;
  border-radius: 999rpx;
  background: var(--zy-color-primary-soft);
  color: var(--zy-color-primary);
  font-size: 20rpx;
}
.state-DEPOSITED_UNVERIFIED { background: var(--zy-color-warning-soft); color: var(--zy-color-warning); }
.state-DEPOSITED_REJECTED,
.state-CONFLICT_SKIPPED,
.state-DUPLICATE_SLOT,
.state-NO_DATE,
.state-UNMAPPED { background: var(--zy-color-fill); color: var(--zy-text-secondary); }
.finding-secondary { margin-top: var(--zy-space-sm); padding: var(--zy-space-sm); border-radius: var(--zy-radius-sm); background: var(--zy-color-fill); }
.finding-text, .finding-action, .report-line {
  color: var(--zy-text-secondary);
  font-size: 23rpx;
  line-height: 1.55;
}
.finding-action { margin-top: var(--zy-space-xs); color: var(--zy-color-primary); }
.report-line { margin-top: var(--zy-space-xs); }
.report-section-title { color: var(--zy-text-title); font-size: 24rpx; font-weight: 600; }
.unreadable {
  margin-top: var(--zy-space-sm);
  padding: 14rpx 16rpx;
  border-radius: var(--zy-radius-sm);
  background: var(--zy-color-warning-soft);
}

/* 沉淀观测核验操作 */
.obs-ops { margin: var(--zy-space-md) -24rpx -24rpx; padding: var(--zy-space-sm) var(--zy-space-md); border-top: 1rpx solid var(--zy-color-border); border-radius: 0 0 var(--zy-radius-card) var(--zy-radius-card); background: #fafcfb; }
.obs-op-row { display: flex; gap: var(--zy-space-sm); }
.obs-op-row + .obs-op-row { margin-top: var(--zy-space-xs); }
.op-btn {
  flex: 1;
  padding: 12rpx 0;
  border-radius: 999rpx;
  font-size: 24rpx;
  text-align: center;
}
.op-confirm { background: var(--zy-color-primary); color: #fff; }
.op-correct { border: 1rpx solid var(--zy-color-primary); color: var(--zy-color-primary); }
.op-reject { border: 1rpx solid var(--zy-color-danger); color: var(--zy-color-danger); }

/* 纠错输入弹层（自绘，风格同 report 页 detail-mask） */
.dialog-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}
.dialog {
  width: 620rpx;
  box-sizing: border-box;
  padding: var(--zy-space-md);
  border-radius: var(--zy-radius-card);
  background: #fff;
}
.dialog-title { color: var(--zy-text-title); font-size: 30rpx; font-weight: 700; }
.dialog-row {
  display: flex;
  justify-content: space-between;
  margin-top: var(--zy-space-sm);
  color: var(--zy-text-secondary);
  font-size: 24rpx;
}
.dialog-row text:last-child { color: var(--zy-text-title); }
.dialog-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 80rpx;
  margin-top: var(--zy-space-sm);
  padding: 20rpx 22rpx;
  border: 1rpx solid var(--zy-color-primary-soft);
  border-radius: var(--zy-radius-sm);
  background: var(--zy-color-fill);
  font-size: 26rpx;
}
.dialog-picker { display: flex; justify-content: space-between; color: var(--zy-text-title); }
.dialog-actions { margin-top: var(--zy-space-md); display: flex; gap: var(--zy-space-sm); }
.dialog-cancel, .dialog-submit {
  flex: 1;
  padding: 18rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  text-align: center;
}
.dialog-cancel { border: 1rpx solid var(--zy-text-weak); color: var(--zy-text-secondary); }
.dialog-submit { background: var(--zy-color-primary); color: #fff; }
