/* 医生问诊页 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.state {
  padding-top: 160rpx;
  text-align: center;
  color: var(--zy-text-weak);
  font-size: 26rpx;
}

/* ===== 医生身份卡 ===== */
.doctor-card {
  display: flex;
  align-items: center;
  padding: var(--zy-space-md);
  background: #fff;
  border-bottom: 1rpx solid #eef3f1;
}

.doctor-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--zy-color-primary);
  color: #fff;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  overflow: hidden;
}

/* 头像图（票 59）：加载失败降级姓氏文字圆 */
.doctor-avatar-img {
  width: 100%;
  height: 100%;
}

.doctor-avatar-text {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.doctor-info {
  flex: 1;
  margin-left: var(--zy-space-sm);
}

.doctor-name {
  color: var(--zy-text-title);
  font-size: 30rpx;
  font-weight: 600;
}

.doctor-title {
  margin-left: var(--zy-space-xs);
  color: var(--zy-text-secondary);
  font-size: 22rpx;
  font-weight: 400;
}

.doctor-org {
  margin-top: 6rpx;
  color: var(--zy-text-weak);
  font-size: 22rpx;
}

.method-label {
  flex: 0 0 auto;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: var(--zy-color-primary-soft);
  color: var(--zy-color-primary);
  font-size: 20rpx;
}

/* ===== 模拟视频面板（深色视频区，纯 UI 模拟） ===== */
.video-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--zy-space-xl) var(--zy-space-md);
  background: linear-gradient(160deg, #173f3a, #0b2723);
}

.video-avatar {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  color: #fff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.video-status {
  margin-top: var(--zy-space-md);
  color: #fff;
  font-size: 26rpx;
}

.video-elapsed {
  margin-top: var(--zy-space-xs);
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
}

/* ===== 终态边缘提示 ===== */
.terminal-bar {
  padding: var(--zy-space-sm) var(--zy-space-md);
  background: #fdf3e3;
  color: #d48806;
  font-size: 24rpx;
  text-align: center;
}

/* ===== 诊断结论/医嘱卡 ===== */
.result-card {
  margin: var(--zy-space-md) var(--zy-space-md) 0;
  padding: var(--zy-space-md);
  border-radius: var(--zy-radius-card);
  background: #fff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.06);
}

.result-title {
  color: var(--zy-color-primary);
  font-size: 30rpx;
  font-weight: 700;
}

.result-section {
  margin-top: var(--zy-space-sm);
}

.result-label {
  color: var(--zy-text-weak);
  font-size: 22rpx;
}

.result-text {
  margin-top: 6rpx;
  color: var(--zy-text-title);
  font-size: 28rpx;
  line-height: 1.6;
}

/* 完成态处方出口（票 60）：样式对齐处方页订单入口链接 */
.prescription-link {
  margin-top: var(--zy-space-sm);
  padding: 18rpx;
  border-radius: 16rpx;
  background: var(--zy-color-primary-soft);
  color: var(--zy-color-primary);
  font-size: 25rpx;
  text-align: center;
}

/* ===== 消息流 ===== */
.thread {
  flex: 1;
  padding: var(--zy-space-md);
  box-sizing: border-box;
}

/* image 消息（票 58）：患者发图按 object_key 回拉，点按全屏预览 */
.msg-image {
  width: 320rpx;
  height: 320rpx;
  border-radius: var(--zy-radius-card);
  display: block;
}

.msg-image-fallback {
  color: var(--zy-text-weak);
  font-size: 24rpx;
  padding: 8rpx 0;
}

.thread-tail {
  height: 2rpx;
}

.empty-msg {
  padding-top: 120rpx;
  text-align: center;
  color: var(--zy-text-weak);
  font-size: 24rpx;
}

.msg-system {
  width: fit-content;
  max-width: 80%;
  margin: var(--zy-space-sm) auto;
  padding: 6rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.05);
  color: var(--zy-text-weak);
  font-size: 22rpx;
  text-align: center;
}

.bubble {
  max-width: 78%;
  padding: 20rpx var(--zy-space-md);
  border-radius: var(--zy-radius-card);
  font-size: 28rpx;
  line-height: 1.55;
  margin: var(--zy-space-sm) 0;
  word-break: break-all;
}

.bubble.user {
  margin-left: auto;
  background: #95deae;
  color: var(--zy-text-title);
  border-bottom-right-radius: 8rpx;
  width: fit-content;
}

.bubble.ai {
  margin-right: auto;
  background: #fff;
  color: var(--zy-text-title);
  border-bottom-left-radius: 8rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
  width: fit-content;
}

/* ===== 语音提示条（票 58）：录音/识别中的瞬态反馈 ===== */
.voice-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 8rpx 0;
  background: var(--zy-color-primary-soft);
  color: var(--zy-color-primary);
  font-size: 24rpx;
}

.voice-hint-error {
  background: #fdf3e3;
  color: #d48806;
}

.voice-hint-spinner {
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid rgba(0, 0, 0, 0.15);
  border-top-color: var(--zy-color-primary);
  border-radius: 50%;
  animation: zy-rotate 0.8s linear infinite;
}

@keyframes zy-rotate {
  to {
    transform: rotate(360deg);
  }
}

/* ===== 输入栏与只读条 ===== */
.composer {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  padding: var(--zy-space-sm) 20rpx var(--zy-space-md);
}

.c-input {
  flex: 1;
  background: #f2f3f5;
  border-radius: 36rpx;
  padding: 18rpx 28rpx;
  font-size: 28rpx;
}

/* 图片入口按钮：复用 AI 对话模块选图/压缩/知情同意模式（票 58） */
.photo-btn {
  flex: 0 0 auto;
  padding: 14rpx 22rpx;
  border-radius: 32rpx;
  background: var(--zy-color-primary-soft);
  color: var(--zy-color-primary);
  font-size: 24rpx;
}

.photo-btn-disabled {
  opacity: 0.45;
}

/* 按住说话（语音输入，票 58）：录音中转圆形高亮 */
.voice-btn {
  flex: 0 0 auto;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f2f3f5;
  color: var(--zy-text-title);
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.voice-btn-active {
  background: var(--zy-color-primary);
  color: #fff;
}

.voice-btn-disabled {
  opacity: 0.45;
}

.send-btn {
  background: var(--zy-color-primary);
  color: #fff;
  border-radius: 32rpx;
  padding: 12rpx 36rpx;
  font-size: 26rpx;
}

.send-btn.send-disabled {
  opacity: 0.45;
}

.readonly-bar {
  background: rgba(245, 245, 245, 0.9);
  color: var(--zy-text-weak);
  font-size: 22rpx;
  text-align: center;
  padding: var(--zy-space-sm);
}
