@import "../../../styles/ai-bubble-state.acss";

/* AI 预问诊对话页：气泡/Markdown/输入栏样式与 pages/chat/index.acss 同源 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.patient-bar {
  padding: var(--zy-space-sm) var(--zy-space-md);
  color: var(--zy-text-secondary);
  font-size: 24rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--zy-color-border);
}

.thread {
  flex: 1;
  padding: var(--zy-space-md);
  box-sizing: border-box;
}

.thread-tail {
  height: 2rpx;
}

/* ===== 空状态 ===== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}

.mascot {
  width: 176rpx;
  height: 176rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--zy-color-primary-soft), var(--zy-color-primary-soft));
  color: var(--zy-color-primary);
  font-size: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.greet {
  margin-top: 28rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--zy-text-title);
}

.greet-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--zy-text-weak);
  text-align: center;
  line-height: 1.6;
}

/* ===== 气泡 ===== */
.bubble {
  max-width: 78%;
  padding: 20rpx var(--zy-space-md);
  border-radius: var(--zy-radius-card);
  font-size: 28rpx;
  line-height: 1.55;
  margin: var(--zy-space-sm) 0;
  word-break: break-all;
}

.bubble.user {
  margin-left: auto;
  background: var(--zy-color-primary);
  color: #fff;
  border-bottom-right-radius: var(--zy-radius-sm);
  width: fit-content;
}

.bubble.ai {
  margin-right: auto;
  background: #fff;
  color: var(--zy-text-title);
  border-bottom-left-radius: var(--zy-radius-sm);
  box-shadow: var(--zy-shadow-card);
  width: fit-content;
}

/* ===== Markdown 块样式（同 pages/chat） ===== */
.md-p, .md-li, .md-h1, .md-h2, .md-h3 {
  margin-top: 12rpx;
}

.md-p:first-child, .md-li:first-child,
.md-h1:first-child, .md-h2:first-child, .md-h3:first-child {
  margin-top: 0;
}

.md-h1 {
  font-size: 34rpx;
  font-weight: 600;
}

.md-h2 {
  font-size: 31rpx;
  font-weight: 600;
}

.md-h3 {
  font-size: 29rpx;
  font-weight: 600;
}

.md-li {
  display: flex;
  margin-top: 8rpx;
}

.md-li-marker {
  flex-shrink: 0;
  margin-right: 10rpx;
}

.md-li-body {
  flex: 1;
}

.md-bold {
  font-weight: 600;
}

/* ===== 红线内联卡（历史回看时呈现） ===== */
.redflag-card {
  margin: var(--zy-space-sm) 0;
  padding: 20rpx var(--zy-space-md);
  border-radius: var(--zy-radius-card);
  background: var(--zy-color-danger);
  color: #fff;
}

.rf-card-title {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.rf-card-body {
  font-size: 26rpx;
  line-height: 1.6;
}

/* ===== 红线全屏覆盖（同 pages/chat/redflag.acss） ===== */
.redflag-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--zy-color-danger);
  z-index: 50;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
  padding: 64rpx;
  text-align: center;
}

.rf-ico { font-size: 88rpx; }
.rf-h { font-size: 40rpx; font-weight: 600; margin-top: var(--zy-space-md); }
.rf-rule { margin-top: var(--zy-space-md); font-size: 30rpx; font-weight: 600; }
.rf-advice { margin-top: var(--zy-space-sm); font-size: 30rpx; line-height: 1.7; }
.rf-tip { margin-top: var(--zy-space-md); font-size: 24rpx; opacity: 0.9; }

.rf-btn {
  margin-top: var(--zy-space-xl);
  border: 1rpx solid #fff;
  border-radius: var(--zy-radius-lg);
  padding: var(--zy-space-sm) 56rpx;
  font-size: 28rpx;
  color: #fff;
  transition: transform var(--zy-motion-fast) var(--zy-ease-out);
}

.rf-btn:active {
  transform: scale(0.98);
}

/* ===== 摘要就绪 CTA ===== */
.cta-bar {
  display: flex;
  align-items: center;
  padding: var(--zy-space-sm) var(--zy-space-md);
  background: #fff;
  border-top: 1rpx solid var(--zy-color-border);
}

.cta-text {
  flex: 1;
  color: var(--zy-text-title);
  font-size: 26rpx;
}

.cta-btn {
  background: var(--zy-color-primary);
  color: #fff;
  border-radius: var(--zy-radius-lg);
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  transition: transform var(--zy-motion-fast) var(--zy-ease-out);
}

.cta-btn:active {
  transform: scale(0.98);
}

/* ===== 输入栏 ===== */
.composer {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: #fff;
  border-top: 1rpx solid var(--zy-color-border);
  padding: var(--zy-space-sm) 20rpx var(--zy-space-md);
}

.abandon-link {
  padding: 12rpx 0;
  background: var(--zy-bg-card);
  color: var(--zy-text-secondary);
  font-size: 23rpx;
  text-align: center;
}

.c-input {
  flex: 1;
  background: var(--zy-color-fill);
  border-radius: var(--zy-radius-lg);
  padding: 18rpx 28rpx;
  font-size: 28rpx;
}

.send-btn {
  background: var(--zy-color-primary);
  color: #fff;
  border-radius: var(--zy-radius-lg);
  padding: 12rpx 36rpx;
  font-size: 26rpx;
  transition: transform var(--zy-motion-fast) var(--zy-ease-out);
}

.send-btn:active {
  transform: scale(0.98);
}

.send-btn.send-disabled {
  opacity: 0.45;
}
