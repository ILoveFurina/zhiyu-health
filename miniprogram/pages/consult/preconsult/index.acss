@import "../../../styles/ai-bubble-state.acss";

/* AI 预问诊对话页：气泡/Markdown/输入栏样式与 pages/chat/index.acss 同源 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.patient-bar {
  padding: var(--zy-space-sm) var(--zy-space-md);
  color: var(--zy-text-secondary);
  font-size: 24rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--zy-color-border);
}

.thread {
  flex: 1;
  padding: var(--zy-space-md);
  box-sizing: border-box;
}

.thread-tail {
  height: 2rpx;
}

/* ===== 空状态 ===== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}

.mascot {
  width: 176rpx;
  height: 176rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--zy-color-primary-soft), var(--zy-color-primary-soft));
  color: var(--zy-color-primary);
  font-size: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.greet {
  margin-top: 28rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--zy-text-title);
}

.greet-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--zy-text-weak);
  text-align: center;
  line-height: 1.6;
}

/* ===== 气泡 ===== */
.bubble {
  max-width: 78%;
  padding: 20rpx var(--zy-space-md);
  border-radius: var(--zy-radius-card);
  font-size: 28rpx;
  line-height: 1.55;
  margin: var(--zy-space-sm) 0;
  word-break: break-all;
}

.bubble.user {
  margin-left: auto;
  background: var(--zy-color-primary);
  color: #fff;
  border-bottom-right-radius: var(--zy-radius-sm);
  width: fit-content;
}

.bubble.ai {
  margin-right: auto;
  background: #fff;
  color: var(--zy-text-title);
  border-bottom-left-radius: var(--zy-radius-sm);
  box-shadow: var(--zy-shadow-card);
  width: fit-content;
}

/* ===== Markdown 块样式（同 pages/chat） ===== */
.md-p, .md-li, .md-h1, .md-h2, .md-h3 {
  margin-top: 12rpx;
}

.md-p:first-child, .md-li:first-child,
.md-h1:first-child, .md-h2:first-child, .md-h3:first-child {
  margin-top: 0;
}

.md-h1 {
  font-size: 34rpx;
  font-weight: 600;
}

.md-h2 {
  font-size: 31rpx;
  font-weight: 600;
}

.md-h3 {
  font-size: 29rpx;
  font-weight: 600;
}

.md-li {
  display: flex;
  margin-top: 8rpx;
}

.md-li-marker {
  flex-shrink: 0;
  margin-right: 10rpx;
}

.md-li-body {
  flex: 1;
}

.md-bold {
  font-weight: 600;
}

/* ===== 红线内联卡（历史回看时呈现） ===== */
.redflag-card {
  margin: var(--zy-space-sm) 0;
  padding: 20rpx var(--zy-space-md);
  border-radius: var(--zy-radius-card);
  background: var(--zy-color-danger);
  color: #fff;
}

.rf-card-title {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.rf-card-body {
  font-size: 26rpx;
  line-height: 1.6;
}

/* ===== 红线全屏覆盖（同 pages/chat/redflag.acss） ===== */
.redflag-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--zy-color-danger);
  z-index: 50;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
  padding: 64rpx;
  text-align: center;
}

.rf-ico { font-size: 88rpx; }
.rf-h { font-size: 40rpx; font-weight: 600; margin-top: var(--zy-space-md); }
.rf-rule { margin-top: var(--zy-space-md); font-size: 30rpx; font-weight: 600; }
.rf-advice { margin-top: var(--zy-space-sm); font-size: 30rpx; line-height: 1.7; }
.rf-tip { margin-top: var(--zy-space-md); font-size: 24rpx; opacity: 0.9; }

.rf-btn {
  margin-top: var(--zy-space-xl);
  border: 1rpx solid #fff;
  border-radius: var(--zy-radius-lg);
  padding: var(--zy-space-sm) 56rpx;
  font-size: 28rpx;
  color: #fff;
  transition: transform var(--zy-motion-fast) var(--zy-ease-out);
}

.rf-btn:active {
  transform: scale(0.98);
}

/* ===== 摘要就绪 CTA ===== */
.cta-bar {
  display: flex;
  align-items: center;
  padding: var(--zy-space-sm) var(--zy-space-md);
  background: #fff;
  border-top: 1rpx solid var(--zy-color-border);
}

.cta-text {
  flex: 1;
  color: var(--zy-text-title);
  font-size: 26rpx;
}

.cta-btn {
  background: var(--zy-color-primary);
  color: #fff;
  border-radius: var(--zy-radius-lg);
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  transition: transform var(--zy-motion-fast) var(--zy-ease-out);
}

.cta-btn:active {
  transform: scale(0.98);
}

/* ===== 输入栏 ===== */
.composer {
  position: relative;
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: #fff;
  border-top: 1rpx solid var(--zy-color-border);
  padding: var(--zy-space-sm) 20rpx var(--zy-space-md);
}

/* 放弃入口（票 86）：次级描边按钮，与等待页取消问诊同款的克制中性样式 */
.abandon-bar {
  padding: var(--zy-space-sm) var(--zy-space-md);
  background: #fff;
}

.btn-abandon {
  box-sizing: border-box;
  padding: var(--zy-space-sm);
  border-radius: 999rpx;
  border: 1rpx solid var(--zy-color-border);
  color: var(--zy-text-secondary);
  background: #fff;
  font-size: 28rpx;
  text-align: center;
  transition: transform var(--zy-motion-fast) var(--zy-ease-out);
}

.btn-abandon:active {
  transform: scale(0.98);
}

.c-input {
  flex: 1;
  background: var(--zy-color-fill);
  border-radius: var(--zy-radius-lg);
  padding: 18rpx 28rpx;
  font-size: 28rpx;
}

.send-btn {
  background: var(--zy-color-primary);
  color: #fff;
  border-radius: var(--zy-radius-lg);
  padding: 12rpx 36rpx;
  font-size: 26rpx;
  transition: transform var(--zy-motion-fast) var(--zy-ease-out);
}

.send-btn:active {
  transform: scale(0.98);
}

.send-btn.send-disabled {
  opacity: 0.45;
}

/* ===== 语音输入（voice-input mixin，与 consult/doctor 同款） ===== */
/* 提示条绝对定位浮于输入栏正上方：出现/消失不推位布局（真机按住说话手势保活） */
.voice-hint {
  position: absolute;
  bottom: 100%;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 8rpx 0;
  background: var(--zy-color-primary-soft);
  color: var(--zy-color-primary);
  font-size: 24rpx;
}

.voice-hint-error {
  background: var(--zy-color-warning-soft);
  color: var(--zy-color-warning);
}

.voice-hint-spinner {
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid rgba(0, 0, 0, 0.15);
  border-top-color: var(--zy-color-primary);
  border-radius: 50%;
  animation: zy-rotate 0.8s linear infinite;
}

@keyframes zy-rotate {
  to {
    transform: rotate(360deg);
  }
}

/* 静态触摸外壳：布局上顶替 voice-btn 的 flex 子项位置，属性不随手势变化（保住 touchend）。
   padding+负 margin 扩大命中热区但不占布局：真机原生 input 命中框小偏移会截获按钮中心
   的触摸（实测"角落可按、中心不可按"，票 45），放大热区抵消偏移 */
.voice-btn-touch {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  margin: -24rpx;
}

/* 按住说话：录音中转圆形高亮 */
.voice-btn {
  flex: 0 0 auto;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--zy-color-fill);
  color: var(--zy-text-title);
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform var(--zy-motion-fast) var(--zy-ease-out);
}

.voice-btn:active {
  transform: scale(0.98);
}

.voice-btn-active {
  background: var(--zy-color-primary);
  color: #fff;
}

.voice-btn-disabled {
  opacity: 0.45;
}
