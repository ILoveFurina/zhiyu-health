<view class="page">
  <!-- 五步进度头：预问诊阶段固定 PRECONSULTATION -->
  <consult-progress current="{{progressStep}}" />
  <view class="patient-bar">就诊人：{{profileName}}</view>

  <scroll-view
    class="thread"
    scroll-y
    scroll-into-view="{{anchorId}}"
    scroll-with-animation
  >
    <view a:if="{{messages.length === 0}}" class="empty">
      <view class="mascot zy-ico zy-ico-plus"></view>
      <view class="greet">开始 AI 预问诊</view>
      <view class="greet-sub">描述你的症状、持续时间和用药情况，小愈会整理病情摘要供医生接诊</view>
    </view>

    <view a:for="{{messages}}" a:key="id">
      <view a:if="{{item.role === 'user'}}" class="bubble user">{{item.content}}</view>

      <view a:elif="{{item.kind === 'red_flag'}}" class="redflag-card">
        <view class="rf-card-title">⚠ 紧急提醒</view>
        <view class="rf-card-body">{{item.content}}</view>
      </view>

      <!-- AI 文本按 Markdown 块渲染（与 pages/chat 同一 block 循环）；blocks 缺失时回退纯文本 -->
      <view a:else class="bubble ai" id="msg-{{item.id}}">
        <view
          a:if="{{item.thinkingText || item.deepThoughtBadge}}"
          class="ai-thinking {{item.thinkingExpanded ? 'ai-thinking-expanded' : ''}}"
          data-id="{{item.id}}"
          onTap="onToggleThinking"
        >
          <view class="ai-thinking-head">
            <text>{{item.thinkingSummary || '深度思考中'}}</text>
            <text a:if="{{item.thinkingText}}" class="ai-thinking-chevron">{{item.thinkingExpanded ? '收起' : '展开'}}</text>
          </view>
          <view a:if="{{item.thinkingText && (!item.thinkingComplete || item.thinkingExpanded)}}" class="ai-thinking-content">{{item.thinkingText}}</view>
        </view>
        <view a:if="{{item.streaming && !item.content}}" class="ai-waiting {{item.toolStatusError ? 'ai-waiting-error' : ''}}">
          <view a:if="{{!item.toolStatusError}}" class="ai-waiting-dots">
            <view class="ai-waiting-dot"></view>
            <view class="ai-waiting-dot"></view>
            <view class="ai-waiting-dot"></view>
          </view>
          <text>{{item.toolStatus || item.waitingText}}</text>
        </view>
        <block a:if="{{item.content && item.blocks && item.blocks.length}}">
          <view a:for="{{item.blocks}}" a:for-item="block" a:key="index">
            <view a:if="{{block.type === 'heading'}}" class="md-h{{block.level}}">
              <text a:for="{{block.segments}}" a:for-item="seg" a:key="index" class="{{seg.bold ? 'md-bold' : ''}}">{{seg.text}}</text>
            </view>
            <view a:elif="{{block.type === 'list_item'}}" class="md-li">
              <text class="md-li-marker">{{block.ordered ? block.index + '.' : '•'}}</text>
              <view class="md-li-body">
                <text a:for="{{block.segments}}" a:for-item="seg" a:key="index" class="{{seg.bold ? 'md-bold' : ''}}">{{seg.text}}</text>
              </view>
            </view>
            <view a:else class="md-p">
              <text a:for="{{block.segments}}" a:for-item="seg" a:key="index" class="{{seg.bold ? 'md-bold' : ''}}">{{seg.text}}</text>
            </view>
          </view>
        </block>
        <text a:elif="{{item.content}}">{{item.content}}</text>
        <ai-disclaimer a:if="{{!item.streaming && item.disclaimer}}" text="{{item.disclaimer}}" />
      </view>
    </view>
    <view id="thread-bottom" class="thread-tail"></view>
  </scroll-view>

  <!-- 摘要快照就绪后的底部 CTA -->
  <view a:if="{{summaryReady}}" class="cta-bar">
    <view class="cta-text">病情摘要已生成</view>
    <view class="cta-btn" onTap="openSummary">查看病情摘要并确认</view>
  </view>

  <view class="composer">
    <!-- 语音提示条：绝对定位浮层，出现不得推位输入栏（票 45 教训，同 chat/doctor 页） -->
    <view a:if="{{voiceHint}}" class="voice-hint {{voiceHintError ? 'voice-hint-error' : ''}}">
      <view a:if="{{!voiceHintError && recording}}" class="voice-hint-spinner" />
      <text>{{voiceHint}}</text>
    </view>
    <!-- 触摸事件挂静态外壳（属性不随手势变化），按钮本体随手势重绘不影响触摸序列；
         padding+负 margin 扩大命中热区，抵消真机原生 input 命中框偏移 -->
    <view
      a:if="{{asrEnabled}}"
      class="voice-btn-touch"
      onTouchStart="onVoiceTouchStart"
      onTouchEnd="onVoiceTouchEnd"
      onTouchCancel="onVoiceTouchCancel"
    >
      <view class="voice-btn {{recording ? 'voice-btn-active' : ''}} {{sending ? 'voice-btn-disabled' : ''}}">
        <view class="zy-ico zy-ico-mic"></view>
      </view>
    </view>
    <input
      class="c-input"
      value="{{inputValue}}"
      onInput="onInput"
      onConfirm="send"
      confirm-type="send"
      placeholder="描述症状、持续时间、用药情况…"
      disabled="{{sending}}"
    />
    <view class="send-btn {{canSend ? '' : 'send-disabled'}}" onTap="send">发送</view>
  </view>

  <!-- 红线症状：全屏红色警告（与 pages/chat 同一行为） -->
  <view a:if="{{redFlag}}" class="redflag-overlay">
    <view class="rf-ico">⚠</view>
    <view class="rf-h">紧急提醒</view>
    <view class="rf-rule">{{redFlag.rule}}</view>
    <view class="rf-advice">{{redFlag.advice}}</view>
    <view class="rf-tip">小愈已中断本次预问诊，你的安全最重要。</view>
    <view class="rf-btn" onTap="closeRedFlag">我知道了</view>
  </view>
</view>
