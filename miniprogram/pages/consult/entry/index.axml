<view class="page">
  <view a:if="{{loading}}" class="state">正在进入在线问诊…</view>

  <!-- 无当前健康档案：与首页/AI 页同一建档引导卡模式 -->
  <view a:elif="{{needProfile}}" class="guide-wrap">
    <view class="profile-guide" onTap="startHealthProfile">
      <view class="profile-guide-icon zy-ico zy-ico-heart"></view>
      <view class="profile-guide-copy">
        <view class="profile-guide-title">建立健康档案</view>
        <view class="profile-guide-text">{{profileRequiredText}}</view>
      </view>
      <view class="profile-guide-arrow">›</view>
    </view>
  </view>
</view>
