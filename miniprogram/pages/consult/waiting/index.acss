/* 等待医生接诊页 */
.page {
  min-height: 100vh;
  padding-bottom: var(--zy-space-lg);
  box-sizing: border-box;
}

.state {
  padding-top: 160rpx;
  text-align: center;
  color: var(--zy-text-weak);
  font-size: 26rpx;
}

.card {
  margin: var(--zy-space-md);
  padding: var(--zy-space-xl) var(--zy-space-md);
  border-radius: var(--zy-radius-card);
  background: #fff;
  box-shadow: var(--zy-shadow-card);
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* ===== 等待态 ===== */
.wait-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid var(--zy-color-primary-soft);
  border-top-color: var(--zy-color-primary);
  border-radius: 50%;
  animation: zy-wait-spin 0.9s linear infinite;
}

@keyframes zy-wait-spin {
  to {
    transform: rotate(360deg);
  }
}

.wait-title {
  margin-top: var(--zy-space-md);
  color: var(--zy-text-title);
  font-size: 32rpx;
  font-weight: 600;
}

.wait-text {
  margin-top: var(--zy-space-sm);
  color: var(--zy-text-secondary);
  font-size: 26rpx;
  text-align: center;
  line-height: 1.6;
}

.wait-countdown {
  margin-top: var(--zy-space-sm);
  color: var(--zy-text-weak);
  font-size: 22rpx;
  animation: zy-countdown-pulse var(--zy-motion-slow) var(--zy-ease-out) infinite alternate;
}

@keyframes zy-countdown-pulse {
  from { opacity: 0.62; transform: scale(0.98); }
  to { opacity: 1; transform: scale(1.02); }
}

/* ===== 终态 ===== */
.terminal-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--zy-color-fill);
  color: var(--zy-text-weak);
  font-size: 44rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.terminal-title {
  margin-top: var(--zy-space-md);
  color: var(--zy-text-title);
  font-size: 32rpx;
  font-weight: 600;
}

.terminal-hint {
  margin-top: var(--zy-space-sm);
  color: var(--zy-text-secondary);
  font-size: 26rpx;
  text-align: center;
  line-height: 1.6;
}

.terminal-resubmit-hint {
  margin-top: var(--zy-space-xs);
  color: var(--zy-text-weak);
  font-size: 22rpx;
  text-align: center;
}

/* ===== 按钮 ===== */
.btn-primary {
  margin-top: var(--zy-space-lg);
  width: 100%;
  box-sizing: border-box;
  padding: var(--zy-space-sm);
  border-radius: 999rpx;
  background: var(--zy-color-primary);
  color: #fff;
  font-size: 28rpx;
  text-align: center;
  transition: transform var(--zy-motion-fast) var(--zy-ease-out);
}

.btn-primary:active {
  transform: scale(0.98);
}

.btn-secondary {
  margin-top: var(--zy-space-sm);
  width: 100%;
  box-sizing: border-box;
  padding: var(--zy-space-sm);
  border-radius: 999rpx;
  border: 1rpx solid var(--zy-color-primary);
  color: var(--zy-color-primary);
  background: #fff;
  font-size: 28rpx;
  text-align: center;
  transition: transform var(--zy-motion-fast) var(--zy-ease-out);
}

.btn-secondary:active {
  transform: scale(0.98);
}

.wait-card .btn-secondary {
  margin-top: var(--zy-space-lg);
  border-color: var(--zy-color-border);
  color: var(--zy-text-secondary);
}

.btn-disabled {
  opacity: 0.45;
}
