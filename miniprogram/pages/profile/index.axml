<view class="page">
  <!-- 账号信息头：mock 登录无头像字段，用昵称首字占位圆 -->
  <view class="account">
    <view class="avatar">{{avatarChar}}</view>
    <view class="account-copy">
      <view class="nickname">{{nickname}}</view>
      <view class="account-sub">智愈健康用户</view>
    </view>
  </view>

  <view a:for="{{sections}}" a:key="title" class="section">
    <view class="section-title">{{item.title}}</view>
    <view class="card">
      <view
        a:for="{{item.items}}"
        a:for-item="entry"
        a:key="key"
        class="row zy-fade-in {{index < item.items.length - 1 ? 'row-border' : ''}}"
        style="animation-delay: {{index * 40}}ms"
        data-url="{{entry.url}}"
        onTap="open"
      >
        <view class="row-icon zy-ico zy-ico-{{entry.icon}}"></view>
        <view class="row-label">{{entry.label}}</view>
        <view class="row-arrow">›</view>
      </view>
    </view>
  </view>
</view>
