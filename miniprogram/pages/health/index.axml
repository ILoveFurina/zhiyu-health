<scroll-view class="page" scroll-y>
  <view class="hero">
    <view>
      <view class="hero-title">健康档案</view>
      <view class="hero-sub">为本人或家人管理健康信息</view>
    </view>
    <view class="add-button" onTap="toggleForm">＋ 新建</view>
  </view>

  <view a:if="{{loading}}" class="state">正在加载…</view>

  <view a:if="{{showForm}}" class="card form-card">
    <view class="section-title">创建服务对象</view>
    <input class="field" placeholder="姓名或称呼" value="{{form.display_name}}" data-field="display_name" onInput="onFormInput" />
    <picker mode="selector" range="{{genders}}" value="{{genderIndex}}" onChange="onGenderChange">
      <view class="field picker-field">性别：{{genders[genderIndex]}} <text>›</text></view>
    </picker>
    <picker mode="date" value="{{form.birth_date}}" end="{{today}}" onChange="onBirthDateChange">
      <view class="field picker-field">出生日期：{{form.birth_date || '请选择'}} <text>›</text></view>
    </picker>
    <picker mode="selector" range="{{relationships}}" value="{{relationshipIndex}}" onChange="onRelationshipChange">
      <view class="field picker-field">与我的关系：{{relationships[relationshipIndex]}} <text>›</text></view>
    </picker>
    <view class="allergy-editor">
      <input class="allergy-input" placeholder="过敏药品或成分（没有可不填）" value="{{allergyInput}}" onInput="onAllergyInput" />
      <view class="small-button" onTap="addDraftAllergy">添加</view>
    </view>
    <view class="chips">
      <view a:for="{{draftAllergies}}" a:key="*this" class="chip danger" data-value="{{item}}" onTap="removeDraftAllergy">{{item}} ×</view>
    </view>
    <view class="submit" onTap="submitProfile">保存并设为当前档案</view>
  </view>

  <view a:if="{{profiles.length}}" class="section">
    <view class="section-title">当前服务对象</view>
    <scroll-view class="profile-strip" scroll-x>
      <view class="profile-row">
        <view a:for="{{profiles}}" a:key="id" class="profile-pill {{item.active ? 'profile-pill-active' : ''}} zy-fade-in" style="animation-delay: {{index * 40}}ms" data-id="{{item.id}}" onTap="switchProfile">
          <view class="avatar">{{item.avatar}}</view>
          <view>
            <view class="profile-name">{{item.display_name}}</view>
            <view class="profile-relation">{{item.relationship}}{{item.active ? ' · 当前' : ''}}</view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 重要健康信息：血型等分类指标最新值 + 过敏史 chips（增删保持现功能） -->
  <view a:if="{{activeProfile}}" class="card">
    <view class="section-title">重要健康信息</view>
    <view class="safe-note">用于确定性用药禁忌检查；信息不完整时系统不会声称已完成个性化检查。</view>
    <view a:for="{{categorical}}" a:key="metric_code" class="info-row">
      <text>{{item.name_zh}}</text>
      <view class="cat-value">
        <text>{{item.display_value}}</text>
        <text a:if="{{item.verification_label}}" class="verify-badge">{{item.verification_label}}</text>
      </view>
    </view>
    <view class="sub-label">过敏史</view>
    <view class="chips">
      <view a:for="{{activeProfile.allergies}}" a:key="*this" class="chip danger" data-value="{{item}}" onTap="removeExistingAllergy">{{item}} ×</view>
      <view a:if="{{activeProfile.allergies.length === 0}}" class="empty-inline">暂未填写</view>
    </view>
    <view class="allergy-editor">
      <input class="allergy-input" placeholder="新增药品或成分" value="{{existingAllergyInput}}" onInput="onExistingAllergyInput" />
      <view class="small-button" onTap="addExistingAllergy">添加</view>
    </view>
  </view>

  <!-- 健康指标：仅渲染有数据的数值指标；有血型行或指标卡时固定挂免责声明 -->
  <view a:if="{{activeProfile && (metrics.length || categorical.length)}}" class="section">
    <view a:if="{{metrics.length}}" class="section-title">健康指标</view>
    <view a:for="{{metrics}}" a:key="metric_code" class="card metric-card zy-fade-in" style="animation-delay: {{index * 40}}ms" data-code="{{item.metric_code}}" data-index="{{index}}" onTap="toggleMetric">
      <view class="metric-head">
        <text class="metric-name">{{item.name_zh}}</text>
        <text a:if="{{item.latest.verification_label}}" class="verify-badge">{{item.latest.verification_label}}</text>
      </view>
      <view class="metric-value">{{item.latest.value}} <text class="metric-unit">{{item.unit}}</text></view>
      <view class="metric-date">{{item.latest.observed_on}}</view>
      <canvas a:if="{{item.showTrend}}" type="2d" id="trend-{{index}}" class="trend-canvas" />
      <view a:if="{{expandedMetric && expandedMetric.code === item.metric_code}}" class="obs-list">
        <view a:if="{{expandedMetric.loading}}" class="empty-inline">正在加载…</view>
        <view a:elif="{{expandedMetric.error}}" class="empty-inline">加载失败，请稍后重试</view>
        <block a:else>
          <view a:if="{{expandedMetric.items.length === 0}}" class="empty-inline">暂无有效观测记录</view>
          <view a:for="{{expandedMetric.items}}" a:for-item="obs" a:key="id" class="obs-row">
            <view class="obs-main">
              <text class="obs-value">{{obs.displayValue}}</text>
              <text a:if="{{obs.reference_range}}" class="obs-ref">参考 {{obs.reference_range}}</text>
            </view>
            <view class="obs-side">
              <text a:if="{{obs.verification_label}}" class="verify-badge">{{obs.verification_label}}</text>
              <text class="obs-date">{{obs.observed_on}}</text>
            </view>
          </view>
          <ai-disclaimer a:if="{{expandedMetric.items.length}}" text="{{expandedMetric.disclaimer}}" />
        </block>
      </view>
      <view class="metric-more">{{expandedMetric && expandedMetric.code === item.metric_code ? '收起' : '查看历次记录'}} ›</view>
    </view>
    <ai-disclaimer text="{{metricsDisclaimer}}" />
  </view>

  <!-- 无指标且无血型数据：行动卡引导上传报告生成健康概要 -->
  <view
    a:if="{{activeProfile && overviewLoaded && metrics.length === 0 && categorical.length === 0}}"
    class="card upload-cta"
    onTap="goUploadReport"
  >
    <view class="cta-title">上传体检报告，生成健康概要</view>
    <view class="cta-sub">AI 提取报告指标并沉淀到健康档案 ›</view>
  </view>

  <!-- 最近报告：报告日期取 exam_date → report_date → created_at；卡底部为上传入口 -->
  <view a:if="{{activeProfile && overviewLoaded}}" class="card">
    <view class="section-title">最近报告</view>
    <view a:if="{{recentReports.length === 0}}" class="empty-inline">暂无报告</view>
    <view a:for="{{recentReports}}" a:key="id" class="report-item zy-fade-in" style="animation-delay: {{index * 40}}ms" data-id="{{item.id}}" onTap="openReportDetail">
      <view class="report-item-head">
        <text class="report-name">{{item.file_name}}</text>
        <text class="report-date">{{item.dateLabel}}</text>
      </view>
      <view a:if="{{item.summary}}" class="report-summary-line">{{item.summary}}</view>
      <view a:if="{{item.attention_count > 0}}" class="attention">需关注 {{item.attention_count}} 项</view>
    </view>
    <ai-disclaimer a:if="{{hasReportSummary}}" text="{{metricsDisclaimer}}" />
    <view class="upload-entry" onTap="goUploadReport">上传体检报告 ›</view>
  </view>

  <view a:if="{{activeProfile}}" class="section">
    <view class="section-title">健康时间线</view>
    <zy-empty a:if="{{timeline.length === 0}}" icon="heart" text="暂无挂号、处方或报告解读记录" />
    <view a:for="{{timeline}}" a:key="record_id" class="timeline-item zy-fade-in" style="animation-delay: {{index * 40}}ms">
      <view class="timeline-dot"></view>
      <view class="timeline-card">
        <view class="timeline-type">{{item.title}}</view>
        <view class="timeline-summary">{{item.summary}}</view>
        <view class="timeline-time">{{item.occurred_at}}</view>
        <ai-disclaimer a:if="{{item.disclaimer}}" text="{{item.disclaimer}}" />
      </view>
    </view>
  </view>
</scroll-view>
