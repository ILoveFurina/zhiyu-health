.page {
  min-height: 100vh;
  padding: 48rpx 28rpx;
  box-sizing: border-box;
}

.hero {
  padding: 32rpx 12rpx 48rpx;
}

.brand {
  color: #0e8a7d;
  font-size: 52rpx;
  font-weight: 700;
}

.subtitle {
  margin-top: 12rpx;
  color: #999;
  font-size: 28rpx;
}

.panel {
  padding: 28rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 12rpx 36rpx rgba(14, 138, 125, 0.08);
}

.summary {
  margin-bottom: 24rpx;
  font-size: 34rpx;
  font-weight: 600;
}

van-button {
  display: block;
  margin-top: 32rpx;
}
