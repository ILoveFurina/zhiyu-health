.page {
  padding: 32rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
}

.overall {
  font-size: 26rpx;
  color: #666;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
}
