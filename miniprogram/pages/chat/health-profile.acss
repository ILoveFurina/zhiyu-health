.profile-guide {
  display: flex;
  align-items: center;
  gap: 18rpx;
  width: 100%;
  box-sizing: border-box;
  margin: 0 0 26rpx;
  padding: 22rpx;
  border: 1rpx solid var(--zy-color-primary-soft);
  border-radius: var(--zy-radius-card);
  background: linear-gradient(135deg, #fff 0%, var(--zy-color-primary-soft) 100%);
  text-align: left;
  transition: transform var(--zy-motion-fast) var(--zy-ease-out);
}

.profile-guide:active {
  transform: scale(0.98);
}

.profile-guide-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: var(--zy-radius-sm);
  background: var(--zy-color-primary);
  color: #fff;
  font-size: 32rpx;
}

.profile-guide-copy { flex: 1; }
.profile-guide-title { color: var(--zy-text-title); font-size: 27rpx; font-weight: 650; }
.profile-guide-text { margin-top: 6rpx; color: var(--zy-text-secondary); font-size: 21rpx; line-height: 1.45; }
.profile-guide-arrow { color: var(--zy-color-primary); font-size: 38rpx; }
.cpill.profile { max-width: 260rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.drawer-my-title { padding: 20rpx 28rpx 6rpx; color: var(--zy-text-weak); font-size: 22rpx; }
.drawer-entry {
  display: flex;
  justify-content: space-between;
  margin: var(--zy-space-xs) var(--zy-space-md);
  padding: 22rpx var(--zy-space-md);
  border-radius: var(--zy-radius-sm);
  background: #fff;
  color: var(--zy-text-title);
  font-size: 27rpx;
  transition: transform var(--zy-motion-fast) var(--zy-ease-out);
}

.drawer-entry:active {
  transform: scale(0.98);
}
