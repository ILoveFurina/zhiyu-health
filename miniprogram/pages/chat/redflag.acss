.redflag-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #e64545;
  z-index: 50;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
  padding: 64rpx;
  text-align: center;
}

.rf-ico { font-size: 88rpx; }
.rf-h { font-size: 40rpx; font-weight: 600; margin-top: 24rpx; }
.rf-rule { margin-top: 24rpx; font-size: 30rpx; font-weight: 600; }
.rf-advice { margin-top: 16rpx; font-size: 30rpx; line-height: 1.7; }
.rf-tip { margin-top: 24rpx; font-size: 24rpx; opacity: 0.9; }

.rf-btn {
  margin-top: 48rpx;
  border: 1rpx solid #fff;
  border-radius: 36rpx;
  padding: 16rpx 56rpx;
  font-size: 28rpx;
  color: #fff;
}
