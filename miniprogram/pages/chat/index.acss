@import "./report.acss";
@import "./redflag.acss";
@import "./drawer.acss";
@import "./feature-bubbles.acss";
@import "./health-profile.acss";

/* 聊天页（演示主画面），视觉对齐 docs/specs/0002-ui-conventions.md */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.thread {
  flex: 1;
  padding: var(--zy-space-md);
  box-sizing: border-box;
}

.thread-tail {
  height: 2rpx;
}

/* ===== 空状态 ===== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}

.appointments-link {
  align-self: flex-end;
  margin-bottom: 20rpx;
  color: var(--zy-color-primary);
  font-size: 24rpx;
}

.mascot {
  width: 176rpx;
  height: 176rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #e8f5f2, #d0ede8);
  color: var(--zy-color-primary);
  font-size: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.greet {
  margin-top: 28rpx;
  font-size: 34rpx;
  font-weight: 600;
}

.greet .brand {
  color: var(--zy-color-primary);
}

.greet-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--zy-text-weak);
}

.topics {
  width: 100%;
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: var(--zy-space-sm);
}

.topic {
  background: #fff;
  border-radius: var(--zy-radius-card);
  padding: var(--zy-space-md) 26rpx;
  display: flex;
  align-items: center;
  gap: var(--zy-space-sm);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.06);
}

.topic .hash {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  background: var(--zy-color-primary);
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}

.topic .topic-text {
  font-size: 26rpx;
  color: var(--zy-text-title);
}

.topic .arrow {
  margin-left: auto;
  color: var(--zy-text-weak);
  font-size: 32rpx;
}

/* ===== 气泡 ===== */
.bubble {
  max-width: 78%;
  padding: 20rpx var(--zy-space-md);
  border-radius: var(--zy-radius-card);
  font-size: 28rpx;
  line-height: 1.55;
  margin: var(--zy-space-sm) 0;
  word-break: break-all;
}

.bubble.user {
  margin-left: auto;
  background: #95deae;
  color: var(--zy-text-title);
  border-bottom-right-radius: 8rpx;
  width: fit-content;
}

.bubble.ai {
  margin-right: auto;
  background: #fff;
  color: var(--zy-text-title);
  border-bottom-left-radius: 8rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
  width: fit-content;
}

/* 票 44：情绪反馈气泡配色--calm 白泡（默认）、anxious 暖橙、fearful 暖红 */
.bubble.ai-anxious {
  background: #fff4e6;
  border-left: 4rpx solid #ff8c00;
}

.bubble.ai-fearful {
  background: #fff0f0;
  border-left: 4rpx solid #e64545;
}

/* 安抚语：附 AI 气泡底部 disclaimer 上方，与回复共用 disclaimer，不单独标注 */
.soothing {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  font-size: 24rpx;
  line-height: 1.55;
  color: var(--zy-text-weak);
}

.cursor {
  color: var(--zy-color-primary);
}

/* ===== 红线内联卡（历史回看时呈现） ===== */
.redflag-card {
  margin: var(--zy-space-sm) 0;
  padding: 20rpx var(--zy-space-md);
  border-radius: var(--zy-radius-card);
  background: #e64545;
  color: #fff;
}

.rf-card-title {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.rf-card-body {
  font-size: 26rpx;
  line-height: 1.6;
}

/* ===== 免责声明常驻细条 ===== */
.disclaimer-bar {
  background: rgba(245, 245, 245, 0.9);
  color: var(--zy-text-weak);
  font-size: 20rpx;
  text-align: center;
  padding: var(--zy-space-xs) var(--zy-space-sm);
}

/* ===== 输入栏 ===== */
.composer {
  background: #fff;
  border-top: 1rpx solid #eee;
  padding: var(--zy-space-sm) 20rpx var(--zy-space-md);
}

.c-row1 {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.c-input {
  flex: 1;
  background: #f2f3f5;
  border-radius: 36rpx;
  padding: 18rpx 28rpx;
  font-size: 28rpx;
}

.c-row2 {
  display: flex;
  align-items: center;
  gap: var(--zy-space-sm);
  margin-top: var(--zy-space-sm);
}

.cpill {
  border: 1rpx solid #e0e0e0;
  border-radius: 28rpx;
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  color: var(--zy-text-title);
  background: #fff;
}

.cpill.gear {
  color: var(--zy-color-primary);
  border-color: var(--zy-color-primary);
}

.send-btn {
  margin-left: auto;
  background: var(--zy-color-primary);
  color: #fff;
  border-radius: 32rpx;
  padding: 12rpx 36rpx;
  font-size: 26rpx;
}

.send-btn.send-disabled {
  opacity: 0.45;
}

/* 工具进度状态条（票 24）：瞬态，输入框上方；tool_start 显示 loading，error 显示失败 */
.tool-progress {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 28rpx;
  margin: 0 24rpx 12rpx;
  background: #f0f5ff;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #595959;
}

.tool-progress-spinner {
  width: 24rpx;
  height: 24rpx;
  border: 4rpx solid #d6e4ff;
  border-top-color: var(--zy-color-primary);
  border-radius: 50%;
  animation: tool-spin 0.8s linear infinite;
}

@keyframes tool-spin {
  to {
    transform: rotate(360deg);
  }
}

.tool-progress-error {
  background: #fff2f0;
  color: #cf1322;
}
