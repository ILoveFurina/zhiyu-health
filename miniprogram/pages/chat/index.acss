@import "./report.acss";
@import "./redflag.acss";
@import "./drawer.acss";
@import "./feature-bubbles.acss";
@import "./health-profile.acss";
@import "../../styles/ai-bubble-state.acss";

/* 聊天页（演示主画面），视觉对齐 docs/specs/0002-ui-conventions.md */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* 页内次级 header：轻量工具栏，不与系统标题栏争夺视觉层级。 */
.chat-header {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 76rpx;
  padding: 8rpx 18rpx 8rpx 30rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #dff2ec 0%, #e6f5f1 100%);
  border-bottom: 1rpx solid rgba(0, 124, 88, 0.09);
}

.chat-header-title {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: var(--zy-text-title);
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chat-header-title-empty {
  height: 40rpx;
}

.chat-header-actions {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-left: var(--zy-space-sm);
  padding: 4rpx;
  border: 1rpx solid rgba(0, 124, 88, 0.08);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.48);
}

.chat-header-btn {
  width: 60rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: transparent;
  color: #52706b;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform var(--zy-motion-fast) var(--zy-ease-out), background-color var(--zy-motion-fast) var(--zy-ease-out);
}

.chat-header-btn:active {
  background: rgba(0, 168, 112, 0.1);
  transform: scale(0.95);
}

.chat-header-new {
  color: var(--zy-color-primary);
  font-size: 32rpx;
}

.thread {
  flex: 1;
  padding: var(--zy-space-md);
  box-sizing: border-box;
}

.thread-tail {
  height: 2rpx;
}

/* ===== 空状态 ===== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 88rpx;
}

.mascot {
  position: relative;
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.82), var(--zy-color-primary-soft));
  border: 1rpx solid rgba(0, 168, 112, 0.08);
  color: var(--zy-color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.mascot-mark {
  position: relative;
  z-index: 1;
  font-size: 54rpx;
}

.greet {
  margin-top: 24rpx;
  color: var(--zy-text-title);
  font-size: 36rpx;
  font-weight: 650;
  letter-spacing: 0.5rpx;
}

.greet .brand {
  color: var(--zy-color-primary);
}

.greet-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--zy-text-secondary);
}

.topics {
  width: 100%;
  margin-top: 36rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.topic {
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid rgba(23, 63, 58, 0.06);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  transition: transform var(--zy-motion-fast) var(--zy-ease-out);
}

.topic:active {
  transform: scale(0.98);
}

.topic-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  background: var(--zy-color-primary-soft);
  color: var(--zy-color-primary);
  font-size: 25rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}

.topic .topic-text {
  font-size: 26rpx;
  color: var(--zy-text-title);
}

/* ===== 气泡 ===== */
.bubble {
  max-width: 78%;
  padding: 20rpx var(--zy-space-md);
  border-radius: var(--zy-radius-card);
  font-size: 28rpx;
  line-height: 1.55;
  margin: var(--zy-space-sm) 0;
  word-break: break-all;
}

/* 票 66：自己发言气泡按手册例外收编为主色底 + 白字 */
.bubble.user {
  margin-left: auto;
  background: var(--zy-color-primary);
  color: #fff;
  border-bottom-right-radius: var(--zy-radius-sm);
  width: fit-content;
}

/* image kind 消息：用户上传的拍照原图缩略图（ADR-0023 回拉 MinIO 原图） */
.image-bubble {
  display: flex;
  align-items: center;
}

.image-msg {
  width: 240rpx;
  height: 240rpx;
  border-radius: var(--zy-radius-sm);
  display: block;
}

.image-msg-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
}

.bubble.ai {
  margin-right: auto;
  background: #fff;
  color: var(--zy-text-title);
  border-bottom-left-radius: var(--zy-radius-sm);
  box-shadow: var(--zy-shadow-card);
  width: fit-content;
}

/* 实时挂载的 AI 气泡与业务卡只在首次出现时播放；SSE token 更新不改变节点 key。 */
@keyframes zy-chat-rise {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.zy-ai-enter,
.zy-business-enter {
  animation: zy-chat-rise var(--zy-motion-base) var(--zy-ease-out) both;
}

/* 票 50：号源查询失败卡「重新查询」按钮（发起新一轮对话，携带 retry_standard_department_id） */
.depslots-retry {
  margin-top: 16rpx;
  padding: 10rpx 36rpx;
  border-radius: 999rpx;
  background: var(--zy-color-primary);
  color: #fff;
  font-size: 26rpx;
  width: fit-content;
  transition: transform var(--zy-motion-fast) var(--zy-ease-out);
}

.depslots-retry:active {
  transform: scale(0.98);
}

/* 票 44：情绪反馈气泡配色--calm 白泡（默认）、anxious 暖橙、fearful 暖红 */
.bubble.ai-anxious {
  background: var(--zy-color-warning-soft);
  border-left: 4rpx solid var(--zy-color-warning);
}

.bubble.ai-fearful {
  background: var(--zy-color-danger-soft);
  border-left: 4rpx solid var(--zy-color-danger);
}

/* 安抚语：附 AI 气泡底部 disclaimer 上方，与回复共用 disclaimer，不单独标注 */
.soothing {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  font-size: 24rpx;
  line-height: 1.55;
  color: var(--zy-text-weak);
}

/* ===== 票 52：AI 气泡 Markdown 块样式 ===== */
.md-p, .md-li, .md-h1, .md-h2, .md-h3 {
  margin-top: 12rpx;
}

.md-p:first-child, .md-li:first-child,
.md-h1:first-child, .md-h2:first-child, .md-h3:first-child {
  margin-top: 0;
}

.md-h1 {
  font-size: 34rpx;
  font-weight: 600;
}

.md-h2 {
  font-size: 31rpx;
  font-weight: 600;
}

.md-h3 {
  font-size: 29rpx;
  font-weight: 600;
}

.md-li {
  display: flex;
  margin-top: 8rpx;
}

.md-li-marker {
  flex-shrink: 0;
  margin-right: 10rpx;
}

.md-li-body {
  flex: 1;
}

.md-bold {
  font-weight: 600;
}

/* ===== 红线内联卡（历史回看时呈现） ===== */
.redflag-card {
  margin: var(--zy-space-sm) 0;
  padding: 20rpx var(--zy-space-md);
  border-radius: var(--zy-radius-card);
  background: var(--zy-color-danger);
  color: #fff;
}

.rf-card-title {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.rf-card-body {
  font-size: 26rpx;
  line-height: 1.6;
}

/* ===== 输入栏 ===== */
.composer {
  background: #fff;
  border-top: 1rpx solid var(--zy-color-border);
  padding: var(--zy-space-sm) 20rpx var(--zy-space-md);
}

.c-row1 {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.c-input {
  flex: 1;
  background: var(--zy-color-fill);
  border-radius: var(--zy-radius-lg);
  padding: 18rpx 28rpx;
  font-size: 28rpx;
}

.c-input-placeholder { color: var(--zy-text-weak); }
.c-input-voice-error { background: var(--zy-color-danger-soft); }
.c-input-placeholder-error { color: var(--zy-color-danger); }

.image-add-btn {
  flex: 0 0 auto;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--zy-color-primary-soft);
  color: var(--zy-color-primary);
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform var(--zy-motion-fast) var(--zy-ease-out);
}

.image-add-btn:active {
  transform: scale(0.95);
}

.image-add-btn-disabled {
  opacity: 0.45;
}

.c-row2 {
  display: flex;
  align-items: center;
  gap: var(--zy-space-sm);
  margin-top: var(--zy-space-sm);
}

.cpill {
  border: 1rpx solid var(--zy-color-border);
  border-radius: var(--zy-radius-lg);
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  color: var(--zy-text-title);
  background: #fff;
  transition: transform var(--zy-motion-fast) var(--zy-ease-out);
}

.cpill:active {
  transform: scale(0.98);
}

.cpill.gear {
  color: var(--zy-color-primary);
  border-color: var(--zy-color-primary);
}

.send-btn {
  margin-left: auto;
  background: var(--zy-color-primary);
  color: #fff;
  border-radius: var(--zy-radius-lg);
  padding: 12rpx 36rpx;
  font-size: 26rpx;
  transition: transform var(--zy-motion-fast) var(--zy-ease-out);
}

.send-btn:active {
  transform: scale(0.98);
}

.send-btn.send-disabled {
  opacity: 0.45;
}

/* ===== 票 45：语音双向 UI ===== */
/* 按住说话按钮：输入框左侧话筒，长按录音、松开识别（asrEnabled=false 时不渲染） */
/* 静态触摸外壳：布局上顶替 voice-btn 的 flex 子项位置，属性不随手势变化（保住 touchend）。
   padding+负 margin 扩大命中热区但不占布局：真机原生 input 同层渲染的命中框存在小偏移，
   按钮中心会被旁侧 input 的无形命中层截获（实测"右下角可按、中心不可按"），放大热区抵消偏移 */
.voice-btn-touch {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  margin: -24rpx;
}

.voice-btn {
  flex: 0 0 auto;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--zy-color-primary);
  color: #fff;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.voice-btn-active {
  background: var(--zy-color-danger);
  animation: zy-voice-pulse var(--zy-motion-slow) var(--zy-ease-out) infinite alternate;
}

@keyframes zy-voice-pulse {
  from { opacity: 0.72; transform: scale(0.96); }
  to { opacity: 1; transform: scale(1.08); }
}

.voice-btn-disabled {
  opacity: 0.45;
}

/* TTS 播报按钮：AI 气泡底部，按需点击触发（不自动播放） */
.tts-btn {
  margin-top: 12rpx;
  align-self: flex-start;
  padding: 8rpx 22rpx;
  border-radius: var(--zy-radius-card);
  background: #f0f5ff;
  color: var(--zy-color-primary);
  font-size: 22rpx;
  transition: transform var(--zy-motion-fast) var(--zy-ease-out);
}

.tts-btn:active {
  transform: scale(0.98);
}

.tts-btn-loading {
  opacity: 0.6;
}

.tts-btn-playing {
  background: var(--zy-color-primary);
  color: #fff;
}

/* 智能导诊引导卡（票 62）：纯客户端 UI，风格对齐 department-slots-card 白卡 */
.guide-card {
  margin: var(--zy-space-sm) 0;
  padding: var(--zy-space-md);
  border-radius: var(--zy-radius-card);
  background: #fff;
  box-shadow: var(--zy-shadow-card);
}

.guide-head {
  display: flex;
  align-items: center;
  gap: var(--zy-space-sm);
}

.guide-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--zy-color-primary-soft);
  color: var(--zy-color-primary);
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.guide-title {
  color: var(--zy-text-title);
  font-size: 32rpx;
  font-weight: 700;
}

.guide-subtitle {
  margin-top: var(--zy-space-xs);
  color: var(--zy-text-secondary);
  font-size: 24rpx;
}

.guide-steps {
  margin-top: var(--zy-space-sm);
  padding: var(--zy-space-xs) var(--zy-space-sm);
  border-radius: var(--zy-radius-sm);
  background: var(--zy-color-fill);
  display: flex;
  justify-content: space-between;
}

.guide-step {
  color: var(--zy-text-secondary);
  font-size: 22rpx;
}

.guide-chips {
  margin-top: var(--zy-space-sm);
  display: flex;
  flex-wrap: wrap;
  gap: var(--zy-space-sm);
}

.guide-chip {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--zy-color-primary);
  color: var(--zy-color-primary);
  font-size: 24rpx;
  transition: transform var(--zy-motion-fast) var(--zy-ease-out);
}

.guide-chip:active {
  transform: scale(0.98);
}

/* 票 65：ambiguous 科室选择卡，视觉与引导卡同族 */
.dep-options-card {
  margin: var(--zy-space-sm) 0;
  padding: var(--zy-space-md);
  border-radius: var(--zy-radius-card);
  background: #fff;
  box-shadow: var(--zy-shadow-card);
}

.dep-options-hint {
  font-size: 26rpx;
  color: var(--zy-text-title);
}

.dep-options-chips {
  margin-top: var(--zy-space-sm);
  display: flex;
  flex-wrap: wrap;
  gap: var(--zy-space-sm);
}

.dep-option-chip {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--zy-color-primary);
  color: var(--zy-color-primary);
  font-size: 24rpx;
  transition: transform var(--zy-motion-fast) var(--zy-ease-out);
}

.dep-option-chip:active {
  transform: scale(0.98);
}
