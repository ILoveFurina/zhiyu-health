<view class="page">
  <!-- 右上角对话记录入口：自绘按钮，不依赖支付宝平台 option menu（见票 27 决策 9） -->
  <view class="option-menu-btn" onTap="openDrawer">≡</view>
  <scroll-view
    class="thread"
    scroll-y
    scroll-into-view="{{anchorId}}"
    scroll-with-animation
  >
    <!-- 空状态：问候 + 3 个推荐提示词（导诊/用药注意/健康管理各一） -->
    <view a:if="{{messages.length === 0}}" class="empty">
      <view class="appointments-link" onTap="openAppointments">我的挂号</view>
      <view a:if="{{profileLoaded && !currentProfile}}" class="profile-guide" onTap="startHealthProfile">
        <view class="profile-guide-icon">♡</view>
        <view class="profile-guide-copy">
          <view class="profile-guide-title">建立健康档案</view>
          <view class="profile-guide-text">录入基础信息与过敏史，获得更安全的个性化服务</view>
        </view>
        <view class="profile-guide-arrow">›</view>
      </view>
      <view class="mascot">✚</view>
      <view class="greet">你好，我是<text class="brand">小愈</text></view>
      <view class="greet-sub">描述症状，我帮你找到合适的科室</view>
      <view class="topics">
        <view
          a:for="{{prompts}}"
          a:key="index"
          class="topic"
          data-text="{{item}}"
          onTap="sendPrompt"
        >
          <view class="hash">#</view>
          <view class="topic-text">{{item}}</view>
          <view class="arrow">›</view>
        </view>
      </view>

      <!-- AI挂号助手主卡（票 49）：与首页同一组件；智能导诊入口复用 enterTriage 导诊引导 -->
      <view class="reg-entry-wrap">
        <registration-card
          cityName="{{regCityName}}"
          hospitals="{{regHospitals}}"
          total="{{regTotal}}"
          onDepartmentEntry="onDepartmentEntry"
          onGuideEntry="onGuideEntry"
          onHospitalTap="onHospitalTap"
          onMoreHospitals="onMoreHospitals"
          onRelocate="onRelocate"
        />
      </view>
    </view>

    <view a:for="{{messages}}" a:key="id">
      <view a:if="{{item.role === 'user' && item.kind !== 'image'}}" class="bubble user">{{item.content}}</view>

      <view a:elif="{{item.kind === 'image'}}" class="bubble user image-bubble">
        <image a:if="{{item.url}}" class="image-msg" src="{{item.url}}" mode="aspectFill" onTap="onPreviewImage" data-url="{{item.url}}" />
        <view a:else class="image-msg-label">📷 {{item.content}}</view>
      </view>

      <view a:elif="{{item.kind === 'red_flag'}}" class="redflag-card">
        <view class="rf-card-title">⚠ 紧急提醒</view>
        <view class="rf-card-body">{{item.content}}</view>
      </view>

      <doctor-card
        a:elif="{{item.kind === 'doctor_recommendations' || item.kind === 'doctor_slots'}}"
        kind="{{item.kind}}"
        card="{{item.card}}"
        onSelectDoctor="onDoctorSelected"
        onSelectSlot="onSlotSelected"
      />

      <hospital-card
        a:elif="{{item.kind === 'hospital_recommendations'}}"
        kind="{{item.kind}}"
        card="{{item.card}}"
        onSelectHospital="onHospitalSelected"
      />

      <!-- 票 50：智能导诊科室号源卡。失败态为文本 + 重新查询；成功态复用票 49 号源卡组件 -->
      <view a:elif="{{item.kind === 'department_slots'}}">
        <view a:if="{{item.card.status === 'failed'}}" class="bubble ai">
          <text>{{item.card.message}}</text>
          <view class="depslots-retry" data-id="{{item.id}}" onTap="onRetryDepartmentSlots">重新查询</view>
          <ai-disclaimer text="{{item.disclaimer}}" />
        </view>
        <block a:else>
          <department-slots-card
            standardDepartment="{{item.card.standard_department}}"
            days="{{item.card.days}}"
            selectedDate="{{item.card.selectedDate}}"
            doctors="{{item.card.doctors}}"
            cardId="{{item.id}}"
            onSelectDate="onDepartmentSlotsSelectDate"
            onBook="onDepartmentSlotsBook"
          />
          <ai-disclaimer text="{{item.disclaimer}}" />
        </block>
      </view>

      <appointment-card
        a:elif="{{item.kind === 'appointment' || item.kind === 'appointments'}}"
        kind="{{item.kind}}"
        card="{{item.card}}"
      />

      <!-- 票 65：ambiguous 科室选择卡。点选科室经 retry 直查通道出号源卡，可重复点 -->
      <view a:elif="{{item.kind === 'department_options'}}" class="dep-options-card" id="msg-{{item.id}}">
        <view class="dep-options-hint">这几个科室都可能，点一个直接查号源：</view>
        <view class="dep-options-chips">
          <view
            a:for="{{item.card.standard_departments}}"
            a:for-item="dept"
            a:key="id"
            class="dep-option-chip"
            data-id="{{dept.id}}"
            data-name="{{dept.name}}"
            onTap="onDepartmentOptionTap"
          >{{dept.name}}</view>
        </view>
        <ai-disclaimer text="{{item.disclaimer}}" />
      </view>

      <view a:elif="{{item.kind === 'report_interpretation'}}" class="report-card">
        <view class="report-card-title">报告解读</view>
        <view class="report-summary">{{item.card.summary}}</view>
        <view a:for="{{item.card.items}}" a:for-item="finding" a:key="index" class="finding">
          <view class="finding-head">
            <view a:if="{{finding.priority === 'red'}}" class="priority-label priority-red">尽快咨询（非急救）</view>
            <view a:elif="{{finding.priority === 'yellow'}}" class="priority-label priority-yellow">重点关注</view>
            <view a:elif="{{finding.priority === 'blue'}}" class="priority-label priority-blue">日常观察</view>
            <view a:else class="priority-label priority-green">范围内</view>
            <text class="finding-name">{{finding.name}}</text>
            <text class="finding-value">{{finding.value}} {{finding.unit}}</text>
          </view>
          <view class="finding-ref">参考范围：{{finding.reference_range}} · 第 {{finding.page}} 页</view>
          <view class="finding-text">{{finding.explanation}}</view>
          <view class="finding-action">建议：{{finding.action}}</view>
        </view>
        <view a:if="{{item.card.actions.length}}" class="report-section">
          <view class="report-section-title">下一步建议</view>
          <view a:for="{{item.card.actions}}" a:key="index" class="report-line">• {{item}}</view>
        </view>
        <view a:if="{{item.card.unreadable.length}}" class="unreadable">
          <view class="report-section-title">未能可靠识别</view>
          <view a:for="{{item.card.unreadable}}" a:key="index" class="report-line">• {{item}}</view>
        </view>
        <ai-disclaimer text="{{item.disclaimer}}" />
      </view>

      <skin-card
        a:elif="{{item.kind === 'skin_analysis'}}"
        card="{{item.card}}"
        disclaimer="{{item.disclaimer}}"
      />

      <diet-card
        a:elif="{{item.kind === 'diet_analysis'}}"
        card="{{item.card}}"
        disclaimer="{{item.disclaimer}}"
      />

      <tongue-card
        a:elif="{{item.kind === 'tongue_analysis'}}"
        card="{{item.card}}"
        disclaimer="{{item.disclaimer}}"
        tcmDisclaimer="{{item.tcmDisclaimer}}"
      />

      <!-- 票 62：智能导诊引导卡（纯客户端 UI，不持久化、不带免责声明） -->
      <view a:elif="{{item.kind === 'feature_guide'}}" class="guide-card" id="msg-{{item.id}}">
        <view class="guide-head">
          <view class="guide-icon">✚</view>
          <view class="guide-title">{{item.guide.title}}</view>
        </view>
        <view class="guide-subtitle">{{item.guide.subtitle}}</view>
        <view class="guide-steps">
          <text a:for="{{item.guide.steps}}" a:key="index" class="guide-step">{{item}}</text>
        </view>
        <view class="guide-chips">
          <view
            a:for="{{item.guide.chips}}"
            a:key="label"
            class="guide-chip"
            data-text="{{item.text}}"
            onTap="sendPrompt"
          >{{item.label}}</view>
        </view>
      </view>

      <view a:else class="bubble ai ai-{{item.emotion || 'calm'}}" id="msg-{{item.id}}">
        <!-- 票 52：AI 文本按 Markdown 块渲染；blocks 缺失（错误消息等）时回退纯文本 -->
        <block a:if="{{item.blocks && item.blocks.length}}">
          <view a:for="{{item.blocks}}" a:for-item="block" a:key="index">
            <view a:if="{{block.type === 'heading'}}" class="md-h{{block.level}}">
              <text a:for="{{block.segments}}" a:for-item="seg" a:key="index" class="{{seg.bold ? 'md-bold' : ''}}">{{seg.text}}</text>
            </view>
            <view a:elif="{{block.type === 'list_item'}}" class="md-li">
              <text class="md-li-marker">{{block.ordered ? block.index + '.' : '•'}}</text>
              <view class="md-li-body">
                <text a:for="{{block.segments}}" a:for-item="seg" a:key="index" class="{{seg.bold ? 'md-bold' : ''}}">{{seg.text}}</text>
              </view>
            </view>
            <view a:else class="md-p">
              <text a:for="{{block.segments}}" a:for-item="seg" a:key="index" class="{{seg.bold ? 'md-bold' : ''}}">{{seg.text}}</text>
            </view>
          </view>
        </block>
        <text a:else>{{item.content}}</text>
        <text a:if="{{item.streaming}}" class="cursor">▍</text>
        <view a:if="{{!item.streaming && item.soothingText}}" class="soothing">{{item.soothingText}}</view>
        <!-- 票 45：TTS 播放/停止按钮（按需点击触发，不自动播放）。ttsEnabled=false 时不渲染 -->
        <view
          a:if="{{!item.streaming && ttsEnabled && item.content}}"
          class="tts-btn {{ttsLoadingId === item.id ? 'tts-btn-loading' : ''}} {{ttsPlayingId === item.id ? 'tts-btn-playing' : ''}}"
          data-id="{{item.id}}"
          onTap="onPlayTts"
        >
          <text a:if="{{ttsLoadingId === item.id}}">合成中…</text>
          <text a:elif="{{ttsPlayingId === item.id}}">⏸ 停止</text>
          <text a:else>▶ 播报</text>
        </view>
        <ai-disclaimer a:if="{{!item.streaming && item.disclaimer}}" text="{{item.disclaimer}}" />
      </view>
    </view>
    <view id="thread-bottom" class="thread-tail"></view>
  </scroll-view>

  <view a:if="{{pendingReport}}" class="pending-report">
    <view class="pending-head">
      <view>
        <view class="pending-title">待发送的报告</view>
        <view class="pending-tip">将发送至多模态模型；请先遮盖身份信息，报告原图留存于历史会话供回看</view>
      </view>
      <view class="pending-count">{{pendingReport.items.length}} 个文件</view>
    </view>
    <view a:for="{{pendingReport.items}}" a:key="path" class="pending-item">
      <view class="pending-index">{{index + 1}}</view>
      <view class="pending-name">{{item.name}}</view>
      <view a:if="{{!pendingReport.isPdf}}" class="order-btn" data-index="{{index}}" data-offset="-1" onTap="moveReportItem">↑</view>
      <view a:if="{{!pendingReport.isPdf}}" class="order-btn" data-index="{{index}}" data-offset="1" onTap="moveReportItem">↓</view>
      <view class="remove-btn" data-index="{{index}}" onTap="removeReportItem">×</view>
    </view>
    <view a:if="{{reportProgress}}" class="report-progress">{{reportProgress}}，正在安全处理…</view>
    <view class="pending-send {{sending ? 'pending-send-disabled' : ''}}" onTap="sendPendingReport">发送并解读</view>
  </view>

  <view a:if="{{pendingSkin}}" class="pending-report">
    <view class="pending-head">
      <view>
        <view class="pending-title">待发送的皮肤照片</view>
        <view class="pending-tip">将发送至多模态模型分析肤质与常见皮肤问题；照片原图会留存于历史会话供回看</view>
      </view>
      <view class="pending-count">{{pendingSkin.items.length}} 张</view>
    </view>
    <view a:for="{{pendingSkin.items}}" a:key="path" class="pending-item">
      <view class="pending-index">{{index + 1}}</view>
      <view class="pending-name">{{item.name}}</view>
      <view class="remove-btn" data-index="{{index}}" onTap="removeSkinItem">×</view>
    </view>
    <view a:if="{{skinProgress}}" class="report-progress">{{skinProgress}}</view>
    <view class="pending-send {{sending ? 'pending-send-disabled' : ''}}" onTap="sendPendingSkin">发送并分析</view>
  </view>

  <view a:if="{{pendingDiet}}" class="pending-report">
    <view class="pending-head">
      <view>
        <view class="pending-title">待发送的饮食照片</view>
        <view class="pending-tip">将发送至多模态模型估算营养与热量并给出饮食建议；结合档案过敏史给出个性化提醒</view>
      </view>
      <view class="pending-count">{{pendingDiet.items.length}} 张</view>
    </view>
    <view a:for="{{pendingDiet.items}}" a:key="path" class="pending-item">
      <view class="pending-index">{{index + 1}}</view>
      <view class="pending-name">{{item.name}}</view>
      <view class="remove-btn" data-index="{{index}}" onTap="removeDietItem">×</view>
    </view>
    <view a:if="{{dietProgress}}" class="report-progress">{{dietProgress}}</view>
    <view class="pending-send {{sending ? 'pending-send-disabled' : ''}}" onTap="sendPendingDiet">发送并分析</view>
  </view>

  <view a:if="{{pendingTongue}}" class="pending-report">
    <view class="pending-head">
      <view>
        <view class="pending-title">待发送的舌苔照片</view>
        <view class="pending-tip">将发送至多模态模型做中医体质辨证与调理方向；调理不出药材方剂，不替代中医面诊</view>
      </view>
      <view class="pending-count">{{pendingTongue.items.length}} 张</view>
    </view>
    <view a:for="{{pendingTongue.items}}" a:key="path" class="pending-item">
      <view class="pending-index">{{index + 1}}</view>
      <view class="pending-name">{{item.name}}</view>
      <view class="remove-btn" data-index="{{index}}" onTap="removeTongueItem">×</view>
    </view>
    <view a:if="{{tongueProgress}}" class="report-progress">{{tongueProgress}}</view>
    <view class="pending-send {{sending ? 'pending-send-disabled' : ''}}" onTap="sendPendingTongue">发送并辨证</view>
  </view>

  <view a:if="{{pendingPillbox}}" class="pending-report">
    <view class="pending-head">
      <view>
        <view class="pending-title">待发送的药盒照片</view>
        <view class="pending-tip">将识别药盒上的药名并流式生成通用药品说明；仅供参考，不替代医生诊断</view>
      </view>
      <view class="pending-count">{{pendingPillbox.items.length}} 张</view>
    </view>
    <view a:for="{{pendingPillbox.items}}" a:key="path" class="pending-item">
      <view class="pending-index">{{index + 1}}</view>
      <view class="pending-name">{{item.name}}</view>
      <view class="remove-btn" data-index="{{index}}" onTap="removePillboxItem">×</view>
    </view>
    <view a:if="{{pillboxProgress}}" class="report-progress">{{pillboxProgress}}</view>
    <view class="pending-send {{sending ? 'pending-send-disabled' : ''}}" onTap="sendPendingPillbox">发送并识别</view>
  </view>

  <!-- 免责声明常驻细条（双保险之二） -->
  <view class="disclaimer-bar">⚠ 仅供参考，不替代医生诊断</view>

  <!-- 功能入口气泡栏（D4）：常驻输入框上方，唯一功能入口；+ 按钮已拆除 -->
  <view class="bubble-bar">
    <view
      a:for="{{bubbles}}"
      a:key="key"
      class="bubble-chip {{sending ? 'bubble-chip-disabled' : ''}}"
      data-action="{{item.action}}"
      onTap="onBubbleTap"
    >
      <view class="bubble-icon">{{item.icon}}</view>
      <view class="bubble-label">{{item.label}}</view>
    </view>
  </view>

  <!-- 工具进度状态条（票 24）：瞬态，不进 messages 数组；输入框上方 -->
  <view a:if="{{toolProgress}}" class="tool-progress {{toolProgressError ? 'tool-progress-error' : ''}}">
    <view a:if="{{!toolProgressError}}" class="tool-progress-spinner" />
    <text>{{toolProgress}}</text>
  </view>

  <!-- 票 45：语音输入提示条（录音中/识别中/失败），瞬态，不进 messages 数组 -->
  <view a:if="{{voiceHint}}" class="tool-progress {{voiceHintError ? 'tool-progress-error' : ''}}">
    <view a:if="{{!voiceHintError && recording}}" class="tool-progress-spinner" />
    <text>{{voiceHint}}</text>
  </view>

  <!-- 输入栏（双行结构） -->
  <view class="composer">
    <view class="c-row1">
      <!-- 票 45：按住说话（asrEnabled=false 时不渲染，降级纯文字输入） -->
      <view
        a:if="{{asrEnabled}}"
        class="voice-btn {{recording ? 'voice-btn-active' : ''}} {{sending ? 'voice-btn-disabled' : ''}}"
        onTouchStart="onVoiceTouchStart"
        onTouchEnd="onVoiceTouchEnd"
        onTouchCancel="onVoiceTouchCancel"
      >{{recording ? '松开' : '🎙'}}</view>
      <input
        class="c-input"
        value="{{inputValue}}"
        onInput="onInput"
        onConfirm="send"
        confirm-type="send"
        placeholder="{{asrEnabled ? '发消息或按住话筒说话…' : '发消息…'}}"
        disabled="{{sending}}"
      />
    </view>
    <view class="c-row2">
      <view class="cpill gear" onTap="cycleGear">{{gearLabel}} ▸</view>
      <view class="cpill profile" onTap="openHealthProfiles">咨询人：{{currentProfile ? currentProfile.display_name : '未建档'}} ▸</view>
      <view class="send-btn {{canSend ? '' : 'send-disabled'}}" onTap="send">发送</view>
    </view>
  </view>

  <!-- 红线症状：全屏红色警告（中断导诊，尽快就医/拨打 120） -->
  <view a:if="{{redFlag}}" class="redflag-overlay">
    <view class="rf-ico">⚠</view>
    <view class="rf-h">紧急提醒</view>
    <view class="rf-rule">{{redFlag.rule}}</view>
    <view class="rf-advice">{{redFlag.advice}}</view>
    <view class="rf-tip">小愈已中断本次导诊，你的安全最重要。</view>
    <view class="rf-btn" onTap="closeRedFlag">我知道了</view>
  </view>

  <!-- 对话记录抽屉：同页浮层，打开不打断 SSE（见票 27 决策 9） -->
  <view a:if="{{drawerOpen}}" class="drawer-mask" onTap="closeDrawer">
    <view class="drawer" catchTap="noop">
      <view class="drawer-head">
        <view class="drawer-title">对话记录</view>
        <view class="drawer-close" onTap="closeDrawer">×</view>
      </view>
      <view class="drawer-my-title">我的</view>
      <view class="drawer-entry" onTap="openHealthProfiles">
        <view>健康档案</view><view>›</view>
      </view>
      <!-- 顶部常驻「新对话」入口（非数据项，见决策 6） -->
      <view class="new-chat" onTap="startNewConversation">
        <view class="new-chat-ico">＋</view>
        <view class="new-chat-text">新对话</view>
      </view>
      <scroll-view class="drawer-list" scroll-y>
        <view a:if="{{drawerLoading}}" class="drawer-state">正在加载…</view>
        <view a:elif="{{conversations.length === 0}}" class="drawer-state">暂无对话记录</view>
        <view
          a:for="{{conversations}}"
          a:key="id"
          class="conv-item {{item.id === conversationId ? 'conv-item-current' : ''}}"
          data-id="{{item.id}}"
          onTap="selectConversation"
          onLongPress="onConversationLongPress"
        >
          <view class="conv-title">{{item.title}}</view>
          <view class="conv-meta">
            <text class="conv-time">{{item.relative}}</text>
            <text a:if="{{item.active}}" class="conv-active">对话中</text>
          </view>
        </view>
      </scroll-view>
      <view class="drawer-tip">长按会话可删除</view>
    </view>
  </view>
</view>
