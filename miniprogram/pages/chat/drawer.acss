/* 对话记录抽屉样式（票 27 决策 6/9）；从 index.acss 拆出以保持单文件职责与行数约束 */

/* ===== 右上角对话记录入口（决策 9：自绘按钮，不用平台 option menu） ===== */
.option-menu-btn {
  position: absolute;
  top: 16rpx;
  right: 24rpx;
  z-index: 20;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
  color: #0e8a7d;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== 对话记录抽屉 ===== */
.drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 60;
}

.drawer {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 78%;
  background: #f7f9f8;
  display: flex;
  flex-direction: column;
}

.drawer-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.drawer-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.drawer-close {
  font-size: 40rpx;
  color: #999;
  padding: 0 8rpx;
}

.new-chat {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 20rpx 24rpx 8rpx;
  padding: 22rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  border: 1rpx solid #0e8a7d;
  color: #0e8a7d;
}

.new-chat-ico {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: #0e8a7d;
  color: #fff;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}

.new-chat-text {
  font-size: 28rpx;
  font-weight: 600;
}

.drawer-list {
  flex: 1;
  padding: 8rpx 24rpx;
  box-sizing: border-box;
}

.drawer-state {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 80rpx 0;
}

.conv-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 26rpx;
  margin: 16rpx 0;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
}

.conv-item-current {
  border: 1rpx solid #0e8a7d;
}

.conv-title {
  font-size: 28rpx;
  color: #1a1a1a;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.conv-meta {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.conv-time {
  font-size: 22rpx;
  color: #999;
}

.conv-active {
  font-size: 22rpx;
  color: #e64545;
}

.drawer-tip {
  text-align: center;
  font-size: 20rpx;
  color: #bbb;
  padding: 16rpx 0 28rpx;
}
