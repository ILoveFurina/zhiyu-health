/* 对话记录抽屉样式（票 27 决策 6/9）；从 index.acss 拆出以保持单文件职责与行数约束 */

/* ===== 对话记录抽屉 ===== */
.drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 60;
}

.drawer {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 78%;
  background: var(--zy-color-fill);
  display: flex;
  flex-direction: column;
}

.drawer-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--zy-space-md) 28rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--zy-color-border);
}

.drawer-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--zy-text-title);
}

.drawer-close {
  font-size: 40rpx;
  color: var(--zy-text-weak);
  padding: 0 8rpx;
}

.drawer-list {
  flex: 1;
  padding: var(--zy-space-xs) var(--zy-space-md);
  box-sizing: border-box;
}

.drawer-state {
  text-align: center;
  color: var(--zy-text-weak);
  font-size: 26rpx;
  padding: 80rpx 0;
}

.conv-item {
  background: #fff;
  border-radius: var(--zy-radius-card);
  padding: var(--zy-space-md) 26rpx;
  margin: var(--zy-space-sm) 0;
  box-shadow: var(--zy-shadow-card);
  transition: transform var(--zy-motion-fast) var(--zy-ease-out);
}

.conv-item:active {
  transform: scale(0.98);
}

.conv-item-current {
  border: 1rpx solid var(--zy-color-primary);
}

.conv-title {
  font-size: 28rpx;
  color: var(--zy-text-title);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.conv-meta {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: var(--zy-space-sm);
}

.conv-time {
  font-size: 22rpx;
  color: var(--zy-text-weak);
}

.conv-active {
  font-size: 22rpx;
  color: var(--zy-color-danger);
}

.drawer-tip {
  text-align: center;
  font-size: 20rpx;
  color: var(--zy-text-weak);
  padding: var(--zy-space-sm) 0 28rpx;
}
