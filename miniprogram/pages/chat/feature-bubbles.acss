/* 功能入口气泡栏（票 19 D4）：常驻输入框上方，唯一功能入口 */
.bubble-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  padding: 14rpx 20rpx;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.bubble-chip {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: var(--zy-space-xs);
  padding: 12rpx 22rpx;
  border-radius: 30rpx;
  background: var(--zy-color-primary-soft);
  color: var(--zy-color-primary);
  font-size: 25rpx;
}

.bubble-chip-disabled {
  opacity: 0.45;
}

.bubble-icon {
  font-size: 26rpx;
  line-height: 1;
}

.bubble-label {
  font-size: 25rpx;
  white-space: nowrap;
}
