.page { min-height: 100vh; padding: var(--zy-space-md); box-sizing: border-box; background: var(--zy-color-fill); }
.state { padding-top: 180rpx; color: var(--zy-text-weak); font-size: 26rpx; text-align: center; }

.dcn-source-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--zy-space-sm); }
.dcn-source-tag { padding: 4rpx 16rpx; border-radius: 999rpx; font-size: 20rpx; font-weight: 600; }
.dcn-source-tag-OTC { background: var(--zy-color-primary-soft); color: var(--zy-color-primary); }
.dcn-source-tag-PRESCRIPTION { background: var(--zy-color-warning-soft); color: var(--zy-color-warning); }
.dcn-realtime-hint { color: var(--zy-text-weak); font-size: 20rpx; }

.dcn-card { margin-bottom: 22rpx; padding: 26rpx; border-radius: var(--zy-radius-card); background: #fff; box-shadow: var(--zy-shadow-card); }
.dcn-card-title { color: var(--zy-text-title); font-size: 28rpx; font-weight: 700; }
.dcn-lock-tag { margin-left: var(--zy-space-sm); padding: 2rpx 12rpx; border-radius: 999rpx; background: var(--zy-color-warning-soft); color: var(--zy-color-warning); font-size: 20rpx; font-weight: 600; }

.dcn-kv { margin-top: var(--zy-space-sm); display: flex; justify-content: space-between; color: var(--zy-text-title); font-size: 26rpx; }
.dcn-k { color: var(--zy-text-weak); font-size: 24rpx; }

.dcn-item { margin-top: var(--zy-space-sm); padding: var(--zy-space-sm); border-radius: var(--zy-radius-sm); border: 1rpx solid var(--zy-color-border); }
.dcn-item-head { display: flex; align-items: center; justify-content: space-between; }
.dcn-item-name { color: var(--zy-text-title); font-size: 28rpx; font-weight: 600; }
.dcn-item-qty { color: var(--zy-text-secondary); font-size: 26rpx; }
.dcn-item-spec { margin-top: 4rpx; color: var(--zy-text-weak); font-size: 22rpx; }

.dcn-pharmacy-hint { margin-top: var(--zy-space-xs); color: var(--zy-text-weak); font-size: 22rpx; }
.dcn-empty { margin-top: var(--zy-space-sm); color: var(--zy-text-weak); font-size: 24rpx; text-align: center; }
.dcn-pharmacy { margin-top: var(--zy-space-sm); padding: var(--zy-space-sm); border-radius: var(--zy-radius-sm); border: 1rpx solid var(--zy-color-border); }
.dcn-pharmacy-on { border-color: var(--zy-color-primary); background: var(--zy-color-primary-soft); }
.dcn-pharmacy-head { display: flex; align-items: center; justify-content: space-between; }
.dcn-pharmacy-name { color: var(--zy-text-title); font-size: 28rpx; font-weight: 600; }
.dcn-pharmacy-distance { flex-shrink: 0; color: var(--zy-color-primary); font-size: 22rpx; }
.dcn-pharmacy-meta { margin-top: 4rpx; color: var(--zy-text-weak); font-size: 22rpx; }
.dcn-pharmacy-quote { margin-top: var(--zy-space-xs); display: flex; gap: var(--zy-space-md); color: var(--zy-text-secondary); font-size: 22rpx; }

.dcn-methods { margin-top: var(--zy-space-sm); display: flex; gap: var(--zy-space-sm); }
.dcn-method { flex: 1; padding: var(--zy-space-sm); border-radius: var(--zy-radius-sm); border: 1rpx solid var(--zy-color-border); }
.dcn-method-on { border-color: var(--zy-color-primary); background: var(--zy-color-primary-soft); }
.dcn-method-name { color: var(--zy-text-title); font-size: 26rpx; font-weight: 600; }
.dcn-method-desc { margin-top: 4rpx; color: var(--zy-text-weak); font-size: 20rpx; }
.dcn-pickup-address { margin-top: var(--zy-space-sm); padding: var(--zy-space-sm); border-radius: var(--zy-radius-sm); background: var(--zy-color-fill); color: var(--zy-text-secondary); font-size: 24rpx; }

.dcn-form { margin-top: var(--zy-space-sm); }
.dcn-input { margin-top: var(--zy-space-sm); padding: 16rpx var(--zy-space-sm); border-radius: var(--zy-radius-sm); border: 1rpx solid var(--zy-color-border); background: #fff; font-size: 26rpx; }
.dcn-consent { margin-top: var(--zy-space-xs); color: var(--zy-text-weak); font-size: 20rpx; }

.dcn-total { margin-top: var(--zy-space-sm); padding-top: var(--zy-space-sm); border-top: 1rpx solid var(--zy-color-border); display: flex; align-items: baseline; justify-content: space-between; }
.dcn-total-label { color: var(--zy-text-secondary); font-size: 24rpx; }
.dcn-total-amount { color: var(--zy-color-primary); font-size: 36rpx; font-weight: 700; }

.dcn-submit { margin-top: var(--zy-space-sm); border: 0; border-radius: var(--zy-radius-lg); background: var(--zy-color-primary); color: #fff; font-size: 30rpx; font-weight: 600; }
