<view class="page">
  <view class="profile-banner" onTap="openHealthProfiles">
    <view>
      <view class="profile-label">当前服务对象</view>
      <view class="profile-name">{{currentProfile ? currentProfile.display_name : '请先建立健康档案'}}</view>
    </view>
    <view class="profile-arrow">切换 ›</view>
  </view>
  <view class="quick-links">
    <view class="quick-link" onTap="openPrescriptions">我的电子处方</view>
    <view class="quick-link" onTap="openDrugOrders">我的药品订单</view>
    <view class="quick-link" onTap="openMessages">站内消息</view>
  </view>
  <scroll-view a:if="{{allAppointments.length > 0}}" scroll-x class="filter-scroll" show-scrollbar="{{false}}">
    <view class="filter-tabs">
      <view
        a:for="{{filterTabs}}"
        a:key="key"
        class="filter-tab {{item.key === activeFilter ? 'filter-tab-active' : ''}}"
        data-key="{{item.key}}"
        onTap="onFilterTap"
      >{{item.label}}</view>
    </view>
  </scroll-view>
  <view a:if="{{loading}}" class="state">正在加载…</view>
  <zy-empty
    a:elif="{{allAppointments.length === 0}}"
    icon="ticket"
    text="暂无挂号记录"
    ctaText="去挂号"
    onCta="goBooking"
  />
  <zy-empty a:elif="{{appointments.length === 0}}" icon="ticket" text="当前筛选下暂无挂号记录" />

  <view a:for="{{appointments}}" a:key="appointment_id" class="card {{item.payment_payable ? 'card-unpaid' : ''}} zy-fade-in" style="animation-delay: {{index * 40}}ms">
    <view class="head">
      <view class="doctor">{{item.department_name}} · {{item.doctor_name}}医生</view>
      <view class="status {{item.isPendingPayment ? 'pending-payment' : ''}} {{item.isBooked ? 'booked' : ''}} {{item.isInProgress ? 'in-progress' : ''}}">{{item.status}}</view>
    </view>
    <view class="meta">{{item.schedule_date}} {{item.time_slot}}</view>
    <view class="number">就诊序号：{{item.sequence_number}} 号</view>
    <view a:if="{{item.registration_fee !== undefined}}" class="payment {{item.payment_payable ? 'payment-unpaid' : ''}}">
      <text>{{item.payment_payable ? '待支付诊查费' : '诊查费'}}</text>
      <text>¥{{item.registration_fee}} · {{item.payment_status_label || '收费记录待补建'}}</text>
    </view>
    <view
      a:if="{{item.payment_payable}}"
      class="pay"
      data-id="{{item.appointment_id}}"
      onTap="pay"
    >模拟支付</view>
    <view a:if="{{item.condition_summary}}" class="summary">病情摘要：{{item.condition_summary}}</view>
    <ai-disclaimer a:if="{{item.summary_disclaimer}}" text="{{item.summary_disclaimer}}" />
    <view a:if="{{item.hasVoucher}}" class="voucher">
      <view class="voucher-title"><text class="zy-ico-ticket voucher-icon"></text>挂号凭证</view>
      <view class="voucher-number">{{item.sequence_number}} 号</view>
      <view class="voucher-row"><text>医生</text><text>{{item.department_name}} · {{item.doctor_name}}医生</text></view>
      <view class="voucher-row"><text>时段</text><text>{{item.schedule_date}} {{item.time_slot}}</text></view>
      <view class="voucher-row"><text>院区</text><text>{{item.hospital_name}} · {{item.campus_name}}</text></view>
      <view class="voucher-row"><text>地址</text><text>{{item.campus_address}}</text></view>
    </view>
    <view
      a:if="{{item.isPendingPayment || item.isBooked}}"
      class="cancel"
      data-id="{{item.appointment_id}}"
      onTap="cancel"
    >取消挂号</view>
  </view>
</view>
