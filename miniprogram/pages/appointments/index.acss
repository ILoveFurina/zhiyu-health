.page {
  min-height: 100vh;
  padding: var(--zy-space-md);
  box-sizing: border-box;
  background: linear-gradient(180deg, #e9f6f2 0%, #f4faf8 48%, #f8faf9 100%);
}

.profile-banner { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; padding: var(--zy-space-md) 26rpx; border-radius: var(--zy-radius-card); background: var(--zy-color-primary-soft); }
.profile-label { color: var(--zy-text-secondary); font-size: 21rpx; }
.profile-name { margin-top: 6rpx; color: var(--zy-text-title); font-size: 29rpx; font-weight: 650; }
.profile-arrow { color: var(--zy-color-primary); font-size: 23rpx; }

.state {
  padding-top: 180rpx;
  color: var(--zy-text-weak);
  font-size: 26rpx;
  text-align: center;
}

.quick-links { display: flex; gap: var(--zy-space-sm); margin-bottom: 20rpx; }
.quick-link { flex: 1; padding: 20rpx; border-radius: 18rpx; background: #fff; color: var(--zy-color-primary); font-size: 25rpx; text-align: center; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.06); }

.card {
  margin-bottom: 20rpx;
  padding: 26rpx;
  border-radius: var(--zy-radius-card);
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.head {
  display: flex;
  align-items: center;
}

.doctor {
  flex: 1;
  color: var(--zy-text-title);
  font-size: 28rpx;
  font-weight: 600;
}

.status {
  color: var(--zy-text-weak);
  font-size: 23rpx;
}

.status.booked {
  color: var(--zy-color-primary);
}

.meta,
.number,
.payment,
.summary {
  margin-top: 12rpx;
  color: var(--zy-text-secondary);
  font-size: 24rpx;
  line-height: 1.55;
}

.payment {
  color: #b26a00;
  font-weight: 600;
}

.summary {
  color: var(--zy-text-title);
}

.cancel {
  margin-top: 20rpx;
  padding: 13rpx 0;
  border: 1rpx solid #e64545;
  border-radius: 28rpx;
  color: #e64545;
  font-size: 24rpx;
  text-align: center;
}
