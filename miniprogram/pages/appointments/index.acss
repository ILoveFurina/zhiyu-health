.page {
  min-height: 100vh;
  padding: var(--zy-space-md);
  box-sizing: border-box;
  background: linear-gradient(180deg, #e9f6f2 0%, #f4faf8 48%, #f8faf9 100%);
}

.profile-banner { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; padding: var(--zy-space-md) 26rpx; border-radius: var(--zy-radius-card); background: var(--zy-color-primary-soft); }
.profile-label { color: var(--zy-text-secondary); font-size: 21rpx; }
.profile-name { margin-top: 6rpx; color: var(--zy-text-title); font-size: 29rpx; font-weight: 650; }
.profile-arrow { color: var(--zy-color-primary); font-size: 23rpx; }

.state {
  padding-top: 180rpx;
  color: var(--zy-text-weak);
  font-size: 26rpx;
  text-align: center;
}

.quick-links { display: flex; gap: var(--zy-space-sm); margin-bottom: 20rpx; }
.quick-link { flex: 1; padding: 20rpx; border-radius: var(--zy-radius-sm); background: #fff; color: var(--zy-color-primary); font-size: 25rpx; text-align: center; box-shadow: var(--zy-shadow-card); }

.card {
  margin-bottom: 20rpx;
  padding: 26rpx;
  border-radius: var(--zy-radius-card);
  background: #fff;
  box-shadow: var(--zy-shadow-card);
  transition: transform var(--zy-motion-fast) var(--zy-ease-out);
}
.card:active { transform: scale(0.98); }

.head {
  display: flex;
  align-items: center;
}

.doctor {
  flex: 1;
  color: var(--zy-text-title);
  font-size: 28rpx;
  font-weight: 600;
}

.status {
  color: var(--zy-text-weak);
  font-size: 23rpx;
}

.status.booked {
  color: var(--zy-color-primary);
}

.status.in-progress {
  color: var(--zy-color-warning);
  font-weight: 600;
}

.meta,
.number,
.payment,
.summary {
  margin-top: 12rpx;
  color: var(--zy-text-secondary);
  font-size: 24rpx;
  line-height: 1.55;
}

.payment {
  color: var(--zy-color-warning);
  font-weight: 600;
}

.summary {
  color: var(--zy-text-title);
}

.voucher {
  position: relative;
  margin-top: 22rpx;
  padding: 22rpx;
  overflow: hidden;
  border: 1rpx solid var(--zy-color-border);
  border-radius: var(--zy-radius-sm);
  background: var(--zy-color-primary-soft);
}

.voucher-title { display: flex; align-items: center; color: var(--zy-text-title); font-size: 25rpx; font-weight: 650; }
.voucher-icon { margin-right: 8rpx; color: var(--zy-color-primary); }
.voucher-number { position: absolute; top: 18rpx; right: 22rpx; color: var(--zy-color-primary); font-size: 34rpx; font-weight: 750; }
.voucher-row { display: flex; gap: 18rpx; margin-top: 13rpx; color: var(--zy-text-title); font-size: 23rpx; line-height: 1.5; }
.voucher-row text:first-child { flex: 0 0 58rpx; color: var(--zy-text-weak); }
.voucher-row text:last-child { flex: 1; text-align: right; }

.cancel,
.pay {
  margin-top: 20rpx;
  padding: 13rpx 0;
  border-radius: var(--zy-radius-lg);
  font-size: 24rpx;
  text-align: center;
}

.pay {
  border: 1rpx solid var(--zy-color-primary);
  color: var(--zy-color-primary);
}

.cancel {
  border: 1rpx solid var(--zy-color-danger);
  color: var(--zy-color-danger);
}
