<view class="page">
  <booking-progress current="{{2}}" />
  <view class="header">
    <view class="subtitle">{{hospitalName}} · 选择就诊科室</view>
  </view>

  <view a:if="{{loading}}" class="state">正在加载…</view>
  <zy-empty a:elif="{{departments.length === 0}}" icon="file" text="该院区暂时没有可预约科室" />

  <view
    a:for="{{departments}}"
    a:key="department_id"
    class="card zy-fade-in"
    style="animation-delay: {{index * 40}}ms"
    data-id="{{item.department_id}}"
    data-name="{{item.name}}"
    onTap="openDoctors"
  >
    <view class="department-mark">科</view>
    <view class="card-main">
      <view class="name-row">
        <text class="name">{{item.name}}</text>
        <text a:if="{{item.category_name}}" class="category">{{item.category_name}}</text>
      </view>
      <view a:if="{{item.floor || item.location}}" class="meta">
        <text class="meta-label">门诊位置</text>
        {{item.floor}}{{item.floor && item.location ? ' · ' : ''}}{{item.location}}
      </view>
    </view>
    <view class="arrow">›</view>
  </view>
</view>
