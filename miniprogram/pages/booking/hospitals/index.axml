<view class="page">
  <booking-progress current="{{0}}" />
  <view class="header">
    <view class="title">预约挂号</view>
    <view class="subtitle">{{cityName ? cityName + ' · ' : ''}}选择你想就诊的医院</view>
  </view>

  <view a:if="{{loading}}">
    <view a:for="{{skelItems}}" a:key="*this" class="zy-skel-card skel-card">
      <view class="zy-skel zy-skel-line" style="width: 42%"></view>
      <view class="zy-skel zy-skel-line skel-line" style="width: 78%"></view>
      <view class="zy-skel zy-skel-line skel-line" style="width: 30%"></view>
    </view>
  </view>
  <zy-empty a:elif="{{hospitals.length === 0}}" icon="file" text="当前城市暂无平台医院" />

  <view
    a:for="{{hospitals}}"
    a:key="hospital_id"
    class="card zy-fade-in"
    style="animation-delay: {{index * 40}}ms"
    data-id="{{item.hospital_id}}"
    data-name="{{item.name}}"
    onTap="openCampuses"
  >
    <view class="card-main">
      <view class="name-row">
        <text class="name">{{item.name}}</text>
        <text a:if="{{item.level}}" class="level">{{item.level}}</text>
      </view>
      <view class="hospital-focus">
        <view class="address">最近院区 · {{item.campus_name}}</view>
        <view a:if="{{item.distance_text}}" class="distance">距您约 {{item.distance_text}} km</view>
      </view>
    </view>
    <view class="arrow">›</view>
  </view>
</view>
