<view class="page">
  <view class="header">
    <view class="subtitle">选择你想预约的医生</view>
  </view>

  <view a:if="{{loading}}" class="state">正在加载…</view>
  <zy-empty a:elif="{{doctors.length === 0}}" icon="file" text="该科室暂时没有可预约医生" />

  <view
    a:for="{{doctors}}"
    a:key="doctor_id"
    class="card zy-fade-in"
    style="animation-delay: {{index * 40}}ms"
    data-id="{{item.doctor_id}}"
    data-name="{{item.name}}"
    data-fee="{{item.registration_fee}}"
    onTap="openSchedules"
  >
    <image
      a:if="{{item.photo_url && !avatarFailed[item.doctor_id]}}"
      class="avatar"
      src="{{item.photo_url}}"
      mode="aspectFill"
      data-id="{{item.doctor_id}}"
      onError="onAvatarError"
    />
    <view a:else class="avatar avatar-fallback">{{item.initial}}</view>
    <view class="card-main">
      <view class="name-row">
        <text class="name">{{item.name}}</text>
        <text a:if="{{item.title}}" class="doctor-title">{{item.title}}</text>
      </view>
      <view a:if="{{item.specialty}}" class="specialty">擅长：{{item.specialty}}</view>
      <view class="fee">挂号费 ¥{{item.registration_fee}}</view>
    </view>
    <view class="arrow">›</view>
  </view>
</view>
