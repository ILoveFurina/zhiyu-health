<view class="page">
  <view class="header">
    <view class="title">{{doctorName}} <text class="title-suffix">{{departmentName}}</text></view>
    <view class="subtitle">选择可预约的日期与时段</view>
  </view>

  <!-- 14 天日期选择器：圆点表示当日有排班 -->
  <scroll-view scroll-x class="day-scroll" show-scrollbar="{{false}}">
    <view class="day-row">
      <view
        a:for="{{days}}"
        a:key="date"
        class="day {{item.date === selectedDate ? 'day-active' : ''}}"
        data-date="{{item.date}}"
        onTap="onSelectDay"
      >
        <view class="day-week">{{item.week_label}}</view>
        <view class="day-label">{{item.day_label}}</view>
        <view class="day-dot {{item.has_schedule ? 'day-dot-on' : ''}}"></view>
      </view>
    </view>
  </scroll-view>

  <view a:if="{{loading}}" class="state">正在加载…</view>
  <zy-empty a:elif="{{slots.length === 0}}" icon="calendar" text="当日暂无排班" />

  <view a:else class="group">
    <view class="group-date">{{selectedDate}}</view>
    <view class="group-card">
      <view
        a:for="{{slots}}"
        a:for-item="slot"
        a:key="schedule_id"
        class="slot zy-fade-in {{slot.remaining_slots <= 0 ? 'slot-disabled' : ''}}"
        style="animation-delay: {{index * 40}}ms"
        data-id="{{slot.schedule_id}}"
        data-date="{{slot.schedule_date}}"
        data-slot="{{slot.time_slot}}"
        data-remaining="{{slot.remaining_slots}}"
        onTap="openConfirm"
      >
        <view class="slot-time">{{slot.time_slot}}</view>
        <view class="slot-remaining">{{slot.remaining_slots <= 0 ? '已约满' : '剩 ' + slot.remaining_slots + ' 个号源'}}</view>
      </view>
    </view>
  </view>
</view>
