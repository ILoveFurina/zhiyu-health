/* 标准科室目录：顶部搜索 + 左科类右科室双栏 */
.page { height: 100vh; display: flex; flex-direction: column; padding: var(--zy-space-md); box-sizing: border-box; }

.search-bar {
  padding: var(--zy-space-xs) var(--zy-space-sm);
  border-radius: 999rpx;
  background: #fff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.06);
}
.search-input { height: 56rpx; color: var(--zy-text-title); font-size: 26rpx; }

.state { padding-top: 180rpx; color: var(--zy-text-weak); font-size: 26rpx; text-align: center; }

.result-item {
  margin-top: var(--zy-space-sm);
  padding: var(--zy-space-md);
  border-radius: var(--zy-radius-card);
  background: #fff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.result-name { color: var(--zy-text-title); font-size: 28rpx; font-weight: 600; }
.result-category {
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: var(--zy-color-primary-soft);
  color: var(--zy-color-primary);
  font-size: 20rpx;
}

.columns { margin-top: var(--zy-space-sm); flex: 1; display: flex; overflow: hidden; }
.col-left { width: 200rpx; height: 100%; }
.cat {
  padding: var(--zy-space-sm);
  color: var(--zy-text-secondary);
  font-size: 26rpx;
  text-align: center;
}
.cat-active {
  border-radius: 16rpx;
  background: #fff;
  color: var(--zy-color-primary);
  font-weight: 700;
}
.col-right { flex: 1; height: 100%; padding-left: var(--zy-space-sm); box-sizing: border-box; }
.dept {
  margin-bottom: var(--zy-space-sm);
  padding: var(--zy-space-md);
  border-radius: var(--zy-radius-card);
  background: #fff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.dept-name { color: var(--zy-text-title); font-size: 28rpx; font-weight: 600; }
.dept-arrow { color: var(--zy-text-weak); font-size: 36rpx; }
