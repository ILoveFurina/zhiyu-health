/* 院区列表：与医院列表同构的白圆角卡片 */
.page { min-height: 100vh; padding: var(--zy-space-md); box-sizing: border-box; }

.header { padding: var(--zy-space-xs) var(--zy-space-xs) 0; }
.subtitle { color: var(--zy-text-secondary); font-size: 26rpx; }

.state { padding-top: 180rpx; color: var(--zy-text-weak); font-size: 26rpx; text-align: center; }

.card {
  margin-top: var(--zy-space-md);
  padding: var(--zy-space-md);
  border-radius: var(--zy-radius-card);
  background: #fff;
  box-shadow: var(--zy-shadow-card);
  display: flex;
  align-items: center;
  transition: transform var(--zy-motion-fast) var(--zy-ease-out);
}
.card:active { transform: scale(0.98); }
.card-main { flex: 1; }
.name { color: var(--zy-text-title); font-size: 30rpx; font-weight: 700; }
.address { margin-top: var(--zy-space-xs); color: var(--zy-text-secondary); font-size: 24rpx; }
.distance { margin-top: 6rpx; color: var(--zy-text-weak); font-size: 22rpx; }
.arrow { margin-left: var(--zy-space-sm); color: var(--zy-text-weak); font-size: 40rpx; }
