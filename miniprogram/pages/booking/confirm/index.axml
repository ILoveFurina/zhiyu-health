<view class="page">
  <view class="card">
    <view class="card-title">确认挂号信息</view>
    <view class="row">
      <text class="label">就诊医生</text>
      <text class="value">{{doctorName}} · {{departmentName}}</text>
    </view>
    <view a:if="{{hospitalName}}" class="row">
      <text class="label">就诊医院</text>
      <text class="value">{{hospitalName}}</text>
    </view>
    <view class="row">
      <text class="label">出诊时间</text>
      <text class="value">{{scheduleDate}} {{timeSlot}}</text>
    </view>
    <view class="row">
      <text class="label">挂号费</text>
      <text class="value fee">¥{{fee}}</text>
    </view>
  </view>

  <view class="tip">挂号成功后可在「我的挂号」中查看就诊序号</view>

  <view
    class="submit {{submitting ? 'submit-disabled' : ''}}"
    onTap="confirmBooking"
  >{{submitting ? '提交中…' : '确认挂号'}}</view>
</view>
