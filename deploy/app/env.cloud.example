# 云服务器应用层部署环境变量模板（compose.app.yaml 的 env_file）。
# 复制为 deploy/app/env.cloud 并填写真实值；env.cloud 已 gitignore，勿提交。
# 与本地 .env 的差异：数据服务与应用同机，地址全部改 127.0.0.1；
# server-java ↔ server-py 互调也走 127.0.0.1。

# ---- 火山方舟（与本地一致，一个 key 覆盖对话/视觉/embedding）----
ARK_API_KEY=填火山方舟API密钥
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_CHAT_MODEL=填锁定的doubao-seed-2.1-turbo版本ID或endpoint-ID
DOUBAO_EMBEDDING_MODEL=填锁定的doubao-embedding-vision版本ID或endpoint-ID
KNOWLEDGE_EMBEDDING_DIMENSION=2048

# ---- 火山语音 ASR（两套鉴权二选一，全空则 server-py 回落 Fake 固定文本）----
VOLC_ASR_APP_ID=
VOLC_ASR_ACCESS_TOKEN=
VOLC_ASR_API_KEY=

# ---- 数据服务（同机 compose.oneclick.yaml 提供，走宿主机 127.0.0.1）----
POSTGRES_PASSWORD=与云端 compose.oneclick.yaml 一致
REDIS_PASSWORD=与云端一致
NEO4J_PASSWORD=与云端一致

DATABASE_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/zhiyu
DATABASE_USER=zhiyu
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
DATABASE_URL=postgresql+psycopg://zhiyu:填PG密码@127.0.0.1:5432/zhiyu
REDIS_URL=redis://:填Redis密码@127.0.0.1:6379/0
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j

# ---- MinIO（ADR-0023，同机）----
MINIO_ENABLED=true
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=与云端一致
MINIO_SECRET_KEY=与云端一致
MINIO_BUCKET=zhiyu-photos

# ---- 鉴权与种子账号（与本地 .env 语义一致）----
JWT_SECRET=改密钥
AGENT_CALLBACK_SECRET=Java与Python服务间共享的高强度随机密钥
JWT_EXPIRE_MINUTES=720
SEED_ADMIN_PASSWORD=设置管理员演示密码
SEED_DOCTOR_PASSWORD=设置医生演示密码（doctor.lin）
SEED_DOCTOR2_PASSWORD=设置第二位医生演示密码（doctor.zhou）
SEED_DOCTORS_PASSWORD=设置其余医生统一演示密码
DEMO_RESET_ENABLED=false
DEMO_FOLLOW_UP_VISIBLE_IMMEDIATELY=false

# ---- 双栈互调（同机 host 网络）----
SERVER_JAVA_BASE_URL=http://127.0.0.1:8080
SERVER_PY_BASE_URL=http://127.0.0.1:8000
# 无 nginx 形态：server-java 直接托管 admin 静态产物（Dockerfile.bundle 拷贝到 /app/admin-dist）。
# 后半段是 Spring 四个默认 classpath 位置，必须显式保留（static-locations 会整体覆盖默认清单）。
ADMIN_STATIC_LOCATIONS=file:/app/admin-dist/,classpath:/META-INF/resources/,classpath:/resources/,classpath:/static/,classpath:/public/
# B 端与 API 同源（同走 :8080），CORS 仅兜底；如有额外前端来源再追加
CORS_ORIGINS=http://127.0.0.1
