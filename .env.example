# ---- 火山方舟（ADR-0004，一个 key 覆盖对话/视觉/embedding）----
# 比赛冻结后必须填写控制台中的具体模型版本 ID 或 endpoint ID（如 ep-...），禁止使用会漂移的 latest/家族别名。
ARK_API_KEY=填火山方舟API密钥
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_CHAT_MODEL=填锁定的doubao-seed-2.1-turbo版本ID或endpoint-ID
DOUBAO_EMBEDDING_MODEL=填锁定的doubao-embedding-vision版本ID或endpoint-ID

# ---- 数据存储（数据库部署于 43.139.160.223，安全组仅放行团队固定公网 IP）----
POSTGRES_PASSWORD=改成高强度数据库密码
REDIS_PASSWORD=改成高强度Redis密码
NEO4J_PASSWORD=改成至少8位的高强度Neo4j密码
NEO4J_TEST_PASSWORD=改成至少8位的独立测试Neo4j密码
DATABASE_URL=postgresql+psycopg://zhiyu:改密码@43.139.160.223:5432/zhiyu
REDIS_URL=redis://:改密码@43.139.160.223:6379/0
NEO4J_URI=bolt://43.139.160.223:7687
NEO4J_USER=neo4j

# ---- 独立测试依赖（不得复用演示数据）----
TEST_DATABASE_URL=postgresql+psycopg://zhiyu:改密码@43.139.160.223:5432/zhiyu_test
TEST_REDIS_URL=redis://:改密码@43.139.160.223:6379/1
TEST_NEO4J_URI=bolt://43.139.160.223:7688
TEST_NEO4J_USER=neo4j
TEST_NEO4J_PASSWORD=改成与NEO4J_TEST_PASSWORD相同的值

JWT_SECRET=改密钥
AGENT_CALLBACK_SECRET=设置Java与Python服务间共享的高强度随机密钥
JWT_EXPIRE_MINUTES=720
SEED_ADMIN_PASSWORD=设置管理员演示密码
SEED_DOCTOR_PASSWORD=设置医生演示密码

# ---- 联调 ----
CORS_ORIGINS=http://localhost:5173
# server-py → server-java 业务工具回调地址（ADR-0009 双栈）
SERVER_JAVA_BASE_URL=http://localhost:8080
# server-java → server-py Agent SSE 调用地址（compose 内默认 host.docker.internal:8000）
SERVER_PY_BASE_URL=http://localhost:8000
