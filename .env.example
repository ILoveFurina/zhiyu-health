# ---- 火山方舟（ADR-0004，一个 key 覆盖对话/视觉/embedding）----
# 比赛冻结后必须填写控制台中的具体模型版本 ID 或 endpoint ID（如 ep-...），禁止使用会漂移的 latest/家族别名。
ARK_API_KEY=填火山方舟API密钥
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_CHAT_MODEL=填锁定的doubao-seed-2.1-turbo版本ID或endpoint-ID
DOUBAO_EMBEDDING_MODEL=填锁定的doubao-embedding-vision版本ID或endpoint-ID

# ---- 数据存储（开发环境服务器 43.139.160.223，本地经 SSH 隧道 / Tailscale 访问；端口不直接开放公网）----
DATABASE_URL=postgresql+psycopg://zhiyu:改密码@127.0.0.1:5432/zhiyu
REDIS_URL=redis://:改密码@127.0.0.1:6379/0
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=改密码

# ---- 独立测试依赖（不得复用演示库/Redis DB/Neo4j 实例）----
TEST_DATABASE_URL=postgresql+psycopg://zhiyu_test:改密码@127.0.0.1:5432/zhiyu_test
TEST_REDIS_URL=redis://:改密码@127.0.0.1:6379/1
TEST_NEO4J_URI=bolt://127.0.0.1:7688
TEST_NEO4J_USER=neo4j
TEST_NEO4J_PASSWORD=改密码

JWT_SECRET=改密钥
JWT_EXPIRE_MINUTES=720

# ---- 联调 ----
CORS_ORIGINS=http://localhost:5173
