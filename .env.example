# ---- 火山方舟（ADR-0004，一个 key 覆盖对话/视觉/embedding）----
# 比赛冻结后必须填写控制台中的具体模型版本 ID 或 endpoint ID（如 ep-...），禁止使用会漂移的 latest/家族别名。
ARK_API_KEY=填火山方舟API密钥
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_CHAT_MODEL=填锁定的doubao-seed-2.1-turbo版本ID或endpoint-ID
DOUBAO_EMBEDDING_MODEL=填锁定的doubao-embedding-vision版本ID或endpoint-ID
# 向量维度路径 B（ADR-0010）：DDL 写死 vector(2048)，doubao-embedding-vision 实际返回 2048
KNOWLEDGE_EMBEDDING_DIMENSION=2048

# ---- 数据存储（云服务器只运行数据库；应用与测试均在本地运行）----
POSTGRES_PASSWORD=改成高强度数据库密码
REDIS_PASSWORD=改成高强度Redis密码
NEO4J_PASSWORD=改成至少8位的高强度Neo4j密码
NEO4J_TEST_PASSWORD=改成至少8位的独立测试Neo4j密码

# server-java 使用 JDBC 与拆分的 Redis 地址
DATABASE_JDBC_URL=jdbc:postgresql://43.139.160.223:5432/zhiyu
DATABASE_USER=zhiyu
REDIS_HOST=43.139.160.223
REDIS_PORT=6379

# server-py 知识检索使用 URL；业务数据只通过 server-java 回调
DATABASE_URL=postgresql+psycopg://zhiyu:改密码@43.139.160.223:5432/zhiyu
REDIS_URL=redis://:改密码@43.139.160.223:6379/0
NEO4J_URI=bolt://43.139.160.223:7687
NEO4J_USER=neo4j

# ---- MinIO 拍照分析原图持久化（ADR-0023）----
# 旁路持久化：MinIO 不可用时 enabled=false 跳过调用，分析主流程正常完成但不留原图。
# 云端 MinIO 部署就绪后置 true 并填连接信息；本地开发可不启用。
MINIO_ENABLED=false
MINIO_ENDPOINT=http://43.139.160.223:9000
MINIO_ACCESS_KEY=改成MinIO访问密钥
MINIO_SECRET_KEY=改成MinIO秘密密钥
MINIO_BUCKET=zhiyu-photos

# ---- 独立测试依赖（测试在本地执行，不得复用演示数据）----
TEST_DATABASE_URL=postgresql+psycopg://zhiyu:改密码@43.139.160.223:5432/zhiyu_test
TEST_REDIS_URL=redis://:改密码@43.139.160.223:6379/1
TEST_NEO4J_URI=bolt://43.139.160.223:7688
TEST_NEO4J_USER=neo4j
TEST_NEO4J_PASSWORD=改成与NEO4J_TEST_PASSWORD相同的值

JWT_SECRET=改密钥
AGENT_CALLBACK_SECRET=设置Java与Python服务间共享的高强度随机密钥
JWT_EXPIRE_MINUTES=720
SEED_ADMIN_PASSWORD=设置管理员演示密码
SEED_DOCTOR_PASSWORD=设置医生演示密码（doctor.lin）
SEED_DOCTOR2_PASSWORD=设置第二位医生演示密码（doctor.zhou）
# 其余 13 位医生（doctors id 3-15，doctor.chen ~ doctor.han）统一演示密码，缺省 doctor123456
SEED_DOCTORS_PASSWORD=设置其余医生统一演示密码
# 演示重置三重保护之一（ADR-0020）：默认关闭，仅演示环境显式置 true 才可用
DEMO_RESET_ENABLED=false
# 随访消息立即可见（票 60 演示开关）：默认关闭，仅演示环境显式置 true 跳过契约 delay_days 延迟
DEMO_FOLLOW_UP_VISIBLE_IMMEDIATELY=false

# ---- 联调 ----
CORS_ORIGINS=http://localhost:5173
# server-py → server-java 业务工具回调地址（ADR-0009 双栈）
SERVER_JAVA_BASE_URL=http://localhost:8080
# server-java → server-py Agent SSE 调用地址（compose 内默认 host.docker.internal:8000）
SERVER_PY_BASE_URL=http://localhost:8000
